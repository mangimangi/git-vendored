#!/usr/bin/env python3
"""Validate whether a repo implements the git-vendored vendor contract.

Standalone validation tool — does not install the vendor, just checks contract
compliance. Eight checks covering the full v2 vendor contract.

The vendor is read with git, the same way an install reads it: its version
tags from `git ls-remote --tags`, then one shallow fetch at the version's tag
into a temporary directory outside the repository, removed afterwards. Both
come from templates/install, which this script ships next to.

Usage:
    python3 validate <url|owner/repo> [--version <version>]

    <url> is any URL git can fetch (https://, ssh://, git@host:path,
    file://); owner/repo means that repository on github.com.

Environment:
    GH_TOKEN / GITHUB_TOKEN - Token handed to git (and to the dry-run
                              install.sh as GH_TOKEN) for private repos;
                              with none, git reads anonymously
"""

import argparse
import contextlib
import importlib.machinery
import importlib.util
import os
import shutil
import subprocess
import sys
import tempfile


HERE = os.path.dirname(os.path.abspath(__file__))
HELPERS_LIB = os.path.join(HERE, "templates", "lib", "vendor-helpers.sh")


def _load_install():
    """Load templates/install as a module: its tag listing and fetch."""
    path = os.path.join(HERE, "templates", "install")
    loader = importlib.machinery.SourceFileLoader("gv_validate_install", path)
    spec = importlib.util.spec_from_loader("gv_validate_install", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


INSTALL = _load_install()


# ── Auth ─────────────────────────────────────────────────────────────────

def get_auth_token():
    """Resolve auth token from environment (GH_TOKEN, then GITHUB_TOKEN)."""
    return os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN")


def _gh_env(token):
    """Environment for the dry-run install.sh, with GH_TOKEN set."""
    env = os.environ.copy()
    if token:
        env["GH_TOKEN"] = token
    return env


# ── Validation result collector ──────────────────────────────────────────

class ValidationResult:
    """Collects pass/fail results for validation checks."""

    def __init__(self):
        self.checks = []

    def passed(self, name, detail=None):
        msg = f"  [PASS] {name}"
        if detail:
            msg += f" ({detail})"
        self.checks.append(("PASS", msg))
        print(msg)

    def failed(self, name, detail=None):
        msg = f"  [FAIL] {name}"
        if detail:
            msg += f" -- {detail}"
        self.checks.append(("FAIL", msg))
        print(msg)

    @property
    def pass_count(self):
        return sum(1 for status, _ in self.checks if status == "PASS")

    @property
    def fail_count(self):
        return sum(1 for status, _ in self.checks if status == "FAIL")

    @property
    def total(self):
        return len(self.checks)

    @property
    def all_passed(self):
        return self.fail_count == 0

    def summary(self):
        if self.all_passed:
            return f"Result: PASS ({self.pass_count}/{self.total} checks passed)"
        return f"Result: FAIL ({self.fail_count}/{self.total} checks failed)"


# ── Fail-fast checks (1-3) ──────────────────────────────────────────────

def check_repo_exists(repo, token, result):
    """Check 1: Repo exists and is accessible (git ls-remote).

    Returns the repo's tags (tag -> commit), or None.
    """
    tags = INSTALL.ls_remote_tags(repo, token)
    if tags is None:
        result.failed("Repo exists", f"cannot access {repo}")
        return None
    result.passed("Repo exists")
    return tags


def resolve(tags, requested_version):
    """Resolve a version as an install does: (Resolved, None) or (None, why)."""
    return INSTALL.pick_version(tags, requested_version or "latest")


def check_install_sh_exists(repo, checkout, result):
    """Check 2: install.sh exists at repo root, at the version's tag."""
    if checkout is None or not os.path.isfile(
            os.path.join(checkout, "install.sh")):
        result.failed("install.sh exists", f"no install.sh at root of {repo}")
        return False
    result.passed("install.sh exists")
    return True


def check_version_resolvable(resolved, reason, result):
    """Check 3: Version is resolvable from the repo's version tags."""
    if resolved is None:
        result.failed("Version resolvable", reason)
        return None
    result.passed("Version resolvable", resolved.version)
    return resolved.version


# ── Collect-and-report checks (4-8) ─────────────────────────────────────

def read_install_sh(checkout):
    """Read install.sh from the vendor checkout, or None."""
    try:
        with open(os.path.join(checkout, "install.sh")) as f:
            return f.read()
    except (OSError, UnicodeDecodeError):
        return None


def check_valid_shebang(script_content, result):
    """Check 4: Valid shebang line."""
    if script_content is None:
        result.failed("Valid shebang", "could not download install.sh")
        return False
    first_line = script_content.split("\n", 1)[0].strip()
    valid_shebangs = ["#!/bin/bash", "#!/usr/bin/env bash"]
    if first_line in valid_shebangs:
        result.passed("Valid shebang", first_line)
        return True
    result.failed("Valid shebang", f"got: {first_line}")
    return False


def check_syntax_valid(script_content, result):
    """Check 5: bash -n syntax check."""
    if script_content is None:
        result.failed("Syntax valid", "could not download install.sh")
        return False
    with tempfile.NamedTemporaryFile(mode="w", suffix=".sh", delete=False) as f:
        f.write(script_content)
        f.flush()
        tmp_path = f.name
    try:
        proc = subprocess.run(
            ["bash", "-n", tmp_path],
            capture_output=True, text=True
        )
        if proc.returncode == 0:
            result.passed("Syntax valid", "bash -n passed")
            return True
        result.failed("Syntax valid", proc.stderr.strip() or "bash -n failed")
        return False
    finally:
        os.unlink(tmp_path)


def run_dryrun_install(repo, version, script_content, token, result,
                       checkout=None, ref=None):
    """Checks 6-8: Dry-run install in sandbox, manifest written, files exist.

    With `checkout`, install.sh gets VENDOR_CHECKOUT and VENDOR_LIB (this
    repository's helper library), so a vendor using the helpers validates
    from the checkout without the network.
    """
    if script_content is None:
        result.failed("Dry-run install", "could not download install.sh")
        result.failed("Manifest written", "skipped (no install.sh)")
        result.failed("Manifest files exist", "skipped (no manifest)")
        return

    sandbox = tempfile.mkdtemp(prefix="gv-validate-")
    try:
        # Set up sandbox paths
        vendor_name = INSTALL.vendor_name_for(repo)
        install_dir = os.path.join(".vendored", "pkg", vendor_name)
        manifest_file = os.path.join(sandbox, "manifest.files")
        script_path = os.path.join(sandbox, "install.sh")

        # Write install.sh to sandbox
        with open(script_path, "w") as f:
            f.write(script_content)
        os.chmod(script_path, 0o755)

        # Create install dir
        abs_install_dir = os.path.join(sandbox, install_dir)
        os.makedirs(abs_install_dir, exist_ok=True)

        # Build environment
        env = _gh_env(token)
        env["VENDOR_REPO"] = repo
        env["VENDOR_REF"] = ref or f"v{version}"
        env["VENDOR_MANIFEST"] = manifest_file
        env["VENDOR_INSTALL_DIR"] = install_dir
        if checkout:
            env["VENDOR_CHECKOUT"] = os.path.abspath(checkout)
            env["VENDOR_LIB"] = HELPERS_LIB

        # Check 6: Dry-run succeeds
        proc = subprocess.run(
            ["bash", script_path],
            capture_output=True, text=True,
            env=env, cwd=sandbox
        )
        if proc.returncode != 0:
            stderr_snippet = proc.stderr.strip()[:200] if proc.stderr else ""
            detail = f"exit code {proc.returncode}"
            if stderr_snippet:
                detail += f": {stderr_snippet}"
            result.failed("Dry-run install", detail)
        else:
            result.passed("Dry-run install", "exit code 0")

        # Check 7: Manifest written
        if not os.path.isfile(manifest_file):
            result.failed("Manifest written",
                          "install.sh did not write to $VENDOR_MANIFEST")
            result.failed("Manifest files exist", "skipped (no manifest)")
            return

        with open(manifest_file) as f:
            manifest_lines = [line.strip() for line in f if line.strip()]

        if not manifest_lines:
            result.failed("Manifest written", "manifest file is empty")
            result.failed("Manifest files exist", "skipped (empty manifest)")
            return

        result.passed("Manifest written", f"{len(manifest_lines)} files")

        # Check 8: Manifest files exist on disk
        missing = []
        for path in manifest_lines:
            full_path = os.path.join(sandbox, path)
            if not os.path.exists(full_path):
                missing.append(path)

        if missing:
            detail = f"{len(missing)} missing: {', '.join(missing[:5])}"
            if len(missing) > 5:
                detail += f" (and {len(missing) - 5} more)"
            result.failed("Manifest files exist", detail)
        else:
            result.passed("Manifest files exist",
                          f"all {len(manifest_lines)} files found on disk")

    finally:
        # Clean up sandbox
        shutil.rmtree(sandbox, ignore_errors=True)


# ── Main ─────────────────────────────────────────────────────────────────

def _fetch(stack, repo, resolved, token):
    """Fetch the vendor at the resolved tag, as an install does; or None."""
    try:
        return stack.enter_context(
            INSTALL.fetch_vendor(repo, resolved.tag, token, resolved.commit))
    except SystemExit:
        return None


def validate(repo, requested_version=None):
    """Run all validation checks against a repo. Returns exit code."""
    token = get_auth_token()
    result = ValidationResult()

    print(f"\nValidating vendor contract: {repo}\n")

    # Fail-fast checks (1-3), reported in that order. Check 2 is evaluated
    # at the resolved tag, so the version is resolved (silently) first.
    tags = check_repo_exists(repo, token, result)
    if tags is None:
        print(f"\n{result.summary()}")
        return 1

    resolved, reason = resolve(tags, requested_version)
    if resolved is None:
        result.failed("install.sh exists", "skipped (no version)")
        check_version_resolvable(resolved, reason, result)
        print(f"\n{result.summary()}")
        return 1

    with contextlib.ExitStack() as stack:
        checkout = _fetch(stack, repo, resolved, token)
        if not check_install_sh_exists(repo, checkout, result):
            print(f"\n{result.summary()}")
            return 1
        version = check_version_resolvable(resolved, reason, result)

        script_content = read_install_sh(checkout)

        # Collect-and-report checks (4-8)
        check_valid_shebang(script_content, result)
        check_syntax_valid(script_content, result)
        run_dryrun_install(repo, version, script_content, token, result,
                           checkout=checkout, ref=resolved.tag)

    print(f"\n{result.summary()}")
    return 0 if result.all_passed else 1


def main():
    parser = argparse.ArgumentParser(
        description="Validate whether a repo implements the git-vendored "
                    "vendor contract.")
    parser.add_argument("repo", help="Repo to validate: a git URL, or "
                                     "owner/repo for github.com")
    parser.add_argument("--version", default="latest",
                        help="Version to validate against (default: latest)")
    args = parser.parse_args()

    sys.exit(validate(args.repo, args.version))


if __name__ == "__main__":
    main()
