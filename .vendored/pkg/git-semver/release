#!/usr/bin/env python3
"""release — CI orchestration for git-semver.

Usage:
    release           Work out the case from the environment and do it
    release bump      Version bump (push or dispatch event handling)
    release publish   Create tags and GitHub releases for bump commits

With no subcommand, release decides for itself what a run should do, so the
decision lives here and not in a workflow file or a per-repo script:

    merge (a change landed on a branch), by the landed commit's subject:
        starts with "chore: bump version"  ->  publish (tag + GitHub releases)
        starts with "chore: install"       ->  nothing, exit 0
        anything else                      ->  bump, as `release bump` on push
                                               (honours install.on_merge and
                                               install.automerge)
    manual (a run started by hand)         ->  bump, as `release bump` on
                                               workflow_dispatch, with inputs
    any other trigger (open, cron, ...)    ->  refused, non-zero exit

The same script serves a git-cicd job and the version-bump.yml workflow:
git-cicd's CICD_* variables win over the GitHub Actions ones whenever they
are set, because inside a git-cicd job on Actions both exist and git-cicd's
describe the job. `release bump` and `release publish` are called by
version-bump.yml and behave as before.

Environment variables (set by git-cicd, the workflow or GitHub Actions):
    CICD_TRIGGER                "merge" or "manual" (no-subcommand mode;
                                wins over GITHUB_EVENT_NAME)
    CICD_BASE                   Commit before the push (wins over
                                GITHUB_EVENT_BEFORE in no-subcommand mode)
    CICD_HEAD                   Landed commit (wins over GITHUB_SHA)
    CICD_TARGET_BRANCH          Branch to sync with (wins over GITHUB_REF)
    CICD_INPUT_BUMP_TYPE        Declared manual input (wins over INPUT_BUMP_TYPE)
    CICD_INPUT_SUBDIRECTORY     Declared manual input (wins over INPUT_SUBDIRECTORY)
    CICD_INPUT_CHANGELOG_DESCRIPTION
                                Declared manual input (wins over
                                INPUT_CHANGELOG_DESCRIPTION)
    GITHUB_EVENT_NAME           "push" or "workflow_dispatch"
    GITHUB_EVENT_BEFORE         Before-SHA for push events
    GITHUB_SHA                  Current commit SHA
    INPUT_BUMP_TYPE             patch|minor|major (dispatch only, default patch)
    INPUT_SUBDIRECTORY          Subdirectory to bump (dispatch only, optional)
    INPUT_CHANGELOG_DESCRIPTION Changelog entry text (dispatch only, optional)
    GH_TOKEN / GITHUB_TOKEN     GitHub token (gh reads either; git-cicd's
                                merge and manual workflows pass GITHUB_TOKEN)
    GITHUB_REPOSITORY           owner/repo (for gh release create)
    GITHUB_REF                  Current branch ref
"""

import json
import os
import subprocess
import sys
import time
from pathlib import Path

SEMVER_SCRIPT = str(Path(__file__).parent / "git-semver")
CONFIG_PATH = ".semver/config.json"


# ── Helpers ────────────────────────────────────────────────────────────────

def run(*cmd, check=True, capture=True):
    """Run a command and return the CompletedProcess."""
    result = subprocess.run(
        list(cmd), capture_output=capture, text=True, check=False,
    )
    if check and result.returncode != 0:
        stderr = result.stderr.strip() if capture else ""
        print(f"Command failed: {' '.join(cmd)}", file=sys.stderr)
        if stderr:
            print(stderr, file=sys.stderr)
        sys.exit(1)
    return result


def read_config():
    """Read install settings from .semver/config.json.

    Returns (on_merge: bool, automerge: bool).
    """
    path = Path(CONFIG_PATH)
    if not path.exists():
        return True, True
    try:
        config = json.loads(path.read_text())
        install = config.get("install", {})
        return bool(install.get("on_merge", True)), bool(install.get("automerge", True))
    except (json.JSONDecodeError, AttributeError):
        return True, True


def configure_git():
    """Set git user for automated commits."""
    run("git", "config", "user.name", "github-actions[bot]")
    run("git", "config", "user.email", "github-actions[bot]@users.noreply.github.com")


def sync_branch():
    """Fast-forward to latest remote to pick up version bumps from queued runs.

    When multiple pushes trigger queued workflow runs (concurrency group with
    cancel-in-progress: false), each run checks out the SHA from event creation
    time. A prior run may have already bumped the version and pushed. Without
    syncing, this run would read a stale VERSION file and try to create a tag
    that already exists.
    """
    target = os.environ.get("CICD_TARGET_BRANCH", "")
    if target:
        branch = target[len("refs/heads/"):] if target.startswith("refs/heads/") else target
    else:
        ref = os.environ.get("GITHUB_REF", "refs/heads/main")
        branch = ref.split("/", 2)[-1] if ref.startswith("refs/heads/") else "main"
    result = run("git", "pull", "--ff-only", "origin", branch, check=False, capture=True)
    if result.returncode != 0:
        print(f"Warning: could not fast-forward to latest {branch}, "
              "proceeding with current checkout")


def git_semver(*args):
    """Call .semver/git-semver with arguments."""
    return run(SEMVER_SCRIPT, *args, capture=False)


def create_pr(branch, title, body, base="main"):
    """Create a branch, push it, and open a GitHub PR."""
    run("git", "checkout", "-b", branch)
    run("git", "push", "-u", "origin", branch)
    run("gh", "pr", "create", "--title", title, "--body", body, "--base", base)


def is_protected_branch_error(result):
    """Check if a push failure is due to branch protection."""
    stderr = result.stderr if result.stderr else ""
    return "GH006" in stderr or "protected branch" in stderr.lower()


def try_push_or_pr(commit_title):
    """Attempt git push; on protected branch failure, fall back to PR.

    Returns True if push succeeded, False if PR was created.
    """
    result = run("git", "push", check=False, capture=True)
    if result.returncode == 0:
        return True

    if is_protected_branch_error(result):
        print("Push rejected by branch protection, falling back to PR")
        branch = f"chore/bump-version-{int(time.time())}"
        create_pr(branch, commit_title, "Automated version bump")
        return False

    # Non-protection push failure — surface error
    print(f"Push failed: {result.stderr.strip()}", file=sys.stderr)
    sys.exit(1)


def create_releases():
    """Create GitHub Releases for tags pointing at HEAD."""
    result = run("git", "tag", "--points-at", "HEAD", capture=True)
    tags = [t for t in result.stdout.strip().split("\n") if t and t != "latest"]
    repo = os.environ.get("GITHUB_REPOSITORY", "")
    for tag in tags:
        print(f"Creating release for {tag}")
        run("gh", "release", "create", tag,
            "--repo", repo, "--title", tag, "--generate-notes")


def first_env(*names):
    """The value of the first of `names` that is set and non-empty, else ""."""
    for name in names:
        value = os.environ.get(name, "")
        if value:
            return value
    return ""


def read_input(name):
    """A manual-run input: CICD_INPUT_<name> when set, else INPUT_<name>.

    A declared git-cicd input is always set, possibly empty, so its presence
    (not its value) decides which variable is read.
    """
    cicd = f"CICD_INPUT_{name}"
    if cicd in os.environ:
        return os.environ[cicd]
    return os.environ.get(f"INPUT_{name}", "")


# ── Bump subcommand ───────────────────────────────────────────────────────

def handle_push_bump(automerge, before=None):
    """Handle push-to-main event for bump subcommand.

    `before` is the commit before the push; when None it is read from
    GITHUB_EVENT_BEFORE (as `release bump` always has).
    """
    if before is None:
        before = os.environ.get("GITHUB_EVENT_BEFORE", "")
        if not before:
            print("Error: GITHUB_EVENT_BEFORE not set", file=sys.stderr)
            sys.exit(1)

    configure_git()
    sync_branch()

    # Always bump without push — we handle push separately
    pre_bump_sha = run("git", "rev-parse", "HEAD", capture=True).stdout.strip()
    git_semver("bump-all", "--since", before, "--no-push")
    head_sha = run("git", "rev-parse", "HEAD", capture=True).stdout.strip()

    if head_sha == pre_bump_sha:
        # No bump was needed
        return

    commit_title = run("git", "log", "-1", "--pretty=%s", capture=True).stdout.strip()

    if not automerge:
        # automerge=false: go straight to PR, no push attempt
        branch = f"chore/bump-version-{int(time.time())}"
        create_pr(branch, commit_title, "Automated version bump")
        return

    pushed = try_push_or_pr(commit_title)
    if pushed:
        # Unprotected branch — publish job won't fire, so tag+release here
        git_semver("tag", "--push")
        create_releases()


def handle_dispatch_bump(automerge):
    """Handle workflow_dispatch event for bump subcommand."""
    bump_type = read_input("BUMP_TYPE") or "patch"
    subdirectory = read_input("SUBDIRECTORY")
    description = read_input("CHANGELOG_DESCRIPTION")

    configure_git()

    # Always bump without push — we handle push separately
    args = [bump_type, "--no-push"]
    if subdirectory:
        args += ["--subdir", subdirectory]
    if description:
        args += ["--description", description]

    git_semver("bump", *args)

    commit_title = run("git", "log", "-1", "--pretty=%s", capture=True).stdout.strip()

    if not automerge:
        # Determine tag for branch naming
        result = run("git", "describe", "--tags", "--exact-match", "HEAD",
                     check=False, capture=True)
        tag = result.stdout.strip() if result.returncode == 0 else "unknown"
        branch = f"chore/bump-version-{tag.replace('/', '-')}"
        create_pr(
            branch,
            f"chore: bump version to {tag}",
            f"Automated version bump to {tag}",
        )
        return

    pushed = try_push_or_pr(commit_title)
    if pushed:
        # Unprotected branch — publish job won't fire, so tag+release here
        git_semver("tag", "--push")
        create_releases()


def cmd_bump():
    """Bump subcommand: handle version bumping with protected branch fallback."""
    event_name = os.environ.get("GITHUB_EVENT_NAME", "")
    on_merge, automerge = read_config()

    if event_name == "push":
        if not on_merge:
            print("on_merge is false, skipping")
            return
        handle_push_bump(automerge)
    elif event_name == "workflow_dispatch":
        handle_dispatch_bump(automerge)
    else:
        print(f"Unknown event: {event_name}", file=sys.stderr)
        sys.exit(1)


# ── Publish subcommand ────────────────────────────────────────────────────

def cmd_publish():
    """Publish subcommand: create tags and GitHub releases."""
    configure_git()
    sync_branch()
    git_semver("tag", "--push")
    create_releases()


# ── No subcommand: decide for itself ─────────────────────────────────────

BUMP_COMMIT_PREFIX = "chore: bump version"
INSTALL_COMMIT_PREFIX = "chore: install"
GITHUB_EVENT_TRIGGERS = {"push": "merge", "workflow_dispatch": "manual"}


def resolve_trigger():
    """Return (trigger, source) for this run.

    CICD_TRIGGER wins when set; otherwise GITHUB_EVENT_NAME is mapped
    (push -> merge, workflow_dispatch -> manual). An unmapped GitHub event
    is returned as-is so the caller can name it in the refusal.
    """
    cicd = os.environ.get("CICD_TRIGGER", "")
    if cicd:
        return cicd, "CICD_TRIGGER"
    event = os.environ.get("GITHUB_EVENT_NAME", "")
    if event:
        return GITHUB_EVENT_TRIGGERS.get(event, event), "GITHUB_EVENT_NAME"
    return "", ""


def landed_subject():
    """Subject line of the landed commit (CICD_HEAD, else GITHUB_SHA, else HEAD)."""
    head = first_env("CICD_HEAD", "GITHUB_SHA") or "HEAD"
    return run("git", "log", "-1", "--format=%s", head, capture=True).stdout.strip()


def handle_merge():
    """A change landed on a branch: publish, nothing, or bump by its subject."""
    subject = landed_subject()
    if subject.startswith(BUMP_COMMIT_PREFIX):
        print(f"Landed commit is a bump commit ({subject!r}): publishing")
        cmd_publish()
        return
    if subject.startswith(INSTALL_COMMIT_PREFIX):
        print(f"Landed commit is an install commit ({subject!r}): nothing to do")
        return

    on_merge, automerge = read_config()
    if not on_merge:
        print("on_merge is false, skipping")
        return
    before = first_env("CICD_BASE", "GITHUB_EVENT_BEFORE")
    if not before:
        print("Error: neither CICD_BASE nor GITHUB_EVENT_BEFORE is set; "
              "cannot tell what the merge changed", file=sys.stderr)
        sys.exit(1)
    handle_push_bump(automerge, before=before)


def cmd_auto():
    """No subcommand: work out whether this run bumps, publishes or does nothing."""
    trigger, source = resolve_trigger()
    if trigger == "merge":
        handle_merge()
    elif trigger == "manual":
        _, automerge = read_config()
        handle_dispatch_bump(automerge)
    elif not trigger:
        print("Error: release with no subcommand needs CICD_TRIGGER (merge or "
              "manual) or GITHUB_EVENT_NAME (push or workflow_dispatch); "
              "neither is set", file=sys.stderr)
        sys.exit(1)
    else:
        print(f"Error: release does not run for trigger {trigger!r} (from "
              f"{source}); it runs on a merge or a manual run", file=sys.stderr)
        sys.exit(1)


# ── Main ──────────────────────────────────────────────────────────────────

def main():
    if len(sys.argv) < 2:
        cmd_auto()
        return

    subcommand = sys.argv[1]
    if subcommand == "bump":
        cmd_bump()
    elif subcommand == "publish":
        cmd_publish()
    else:
        print(f"Unknown subcommand: {subcommand}", file=sys.stderr)
        print("Usage: release [bump|publish]", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
