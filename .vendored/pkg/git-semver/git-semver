#!/usr/bin/env python3
"""git-semver — config-driven semantic versioning for git repos.

Subcommands:
    version                          Print current version
    check [--since <commit>]         Check if a bump is needed (exit 0=yes, 1=no)
    bump [patch|minor|major] [opts]  Bump version, commit, tag, push
    bump-all --since <commit> [opts] Check all components, bump all triggered
    tag [--push] [--subdir <name>]   Create version tags from VERSION files
    released [<ref>]                 Print the version tags at a commit (read-only)
    label <version> defect --reason "..." [--fixed-in <version>]
                                     Label a released version in git-deps.labels.json
    unlabel <version> <name>         Withdraw a label
    labels [<version>] [--json]      List labels
    check-bump [--base <rev>] [--head <rev>] [--fix|--no-fix]
                                     Fail when a change touches configured files
                                     without raising the version; in fixing mode
                                     also commit the missing patch bump and
                                     push it with CICD_WRITE_TOKEN

Config: .vendored/configs/git-semver.json (see README for schema)
"""

import argparse
import base64
import json
import os
import re
import subprocess
import sys
from datetime import datetime, timezone
from fnmatch import fnmatch
from pathlib import Path

CONFIG_PATH = ".vendored/configs/git-semver.json"
DEFAULT_VERSION_FILE = "VERSION"

# Keys reserved for root-level config (not subdirectory names)
RESERVED_KEYS = frozenset({
    "version_file", "files", "updates", "changelog", "install", "bump_on",
    "push_bump",
})


class SemverError(Exception):
    """Raised for git-semver operational errors."""
    pass


# ── Config ──────────────────────────────────────────────────────────────────

def load_config(config_path=None):
    """Load config from vendored configs path."""
    path = Path(config_path) if config_path else Path(CONFIG_PATH)

    if not path.exists():
        raise SemverError(f"Config not found: {path}")
    with open(path) as f:
        raw = json.load(f)

    # Filter out framework-owned _vendor key
    config = {k: v for k, v in raw.items() if k != "_vendor"}
    return config


def get_subdirectories(config):
    """Extract subdirectory configs from root config.

    Any top-level key that is not reserved, does not start with '_',
    and whose value is a dict is treated as a subdirectory configuration.
    """
    subdirs = {}
    for key, value in config.items():
        if key.startswith("_"):
            continue
        if key not in RESERVED_KEYS and isinstance(value, dict):
            subdirs[key] = value
    return subdirs


def get_subdir_config(config, subdir):
    """Get and validate config for a specific subdirectory."""
    subdirs = get_subdirectories(config)
    if subdir not in subdirs:
        raise SemverError(f"Subdirectory '{subdir}' not found in config")
    return subdirs[subdir]


def get_version_file(config):
    """Return the version_file path from config (default: VERSION)."""
    return config.get("version_file", DEFAULT_VERSION_FILE)


def parse_changelog_config(config, subdir=None):
    """Parse changelog config into (enabled, file, ignore_prefixes).

    For subdirectories, checks the subdir config first, then inherits
    from root config. The default file for subdirectories is
    <subdir>/CHANGELOG.md.

    Returns:
        (enabled: bool, file: str | None, ignore_prefixes: list[str])
    """
    default_file = f"{subdir}/CHANGELOG.md" if subdir else "CHANGELOG.md"

    if subdir is not None:
        subconfig = get_subdir_config(config, subdir)
        if "changelog" in subconfig:
            return _parse_changelog_value(subconfig["changelog"], default_file)
        # Inherit from root — but always use subdir's default file path
        root_cl = config.get("changelog", True)
        if isinstance(root_cl, dict):
            enabled = root_cl.get("enabled", True)
            if not enabled:
                return False, None, []
            return (
                True,
                default_file,
                root_cl.get("ignore_prefixes", []),
            )
        return _parse_changelog_value(root_cl, default_file)

    return _parse_changelog_value(config.get("changelog", True), default_file)


def _parse_changelog_value(cl, default_file="CHANGELOG.md"):
    """Parse a single changelog config value.

    Accepts:
        - Boolean true/false (backward compat, deprecated)
        - None (treated as enabled with defaults)
        - Object with optional keys: enabled, file, ignore_prefixes

    Returns:
        (enabled: bool, file: str | None, ignore_prefixes: list[str])
    """
    if cl is False:
        return False, None, []
    if cl is True or cl is None:
        return True, default_file, []
    # Object form
    enabled = cl.get("enabled", True)
    if not enabled:
        return False, None, []
    return (
        True,
        cl.get("file", default_file),
        cl.get("ignore_prefixes", []),
    )


# ── Version ─────────────────────────────────────────────────────────────────

def read_version(version_file):
    """Read current version from version_file."""
    path = Path(version_file)
    if not path.exists():
        raise SemverError(f"Version file not found: {path}")
    return path.read_text().strip()


def parse_version(version_str):
    """Parse 'X.Y.Z' into (major, minor, patch) ints."""
    parts = version_str.split(".")
    if len(parts) != 3:
        raise SemverError(f"Invalid version format: {version_str}")
    try:
        return int(parts[0]), int(parts[1]), int(parts[2])
    except ValueError:
        raise SemverError(f"Invalid version format: {version_str}")


def compute_new_version(major, minor, patch, bump_type):
    """Compute the new version tuple given a bump type."""
    if bump_type == "major":
        return major + 1, 0, 0
    elif bump_type == "minor":
        return major, minor + 1, 0
    else:
        return major, minor, patch + 1


def format_version(major, minor, patch):
    """Format version tuple as string."""
    return f"{major}.{minor}.{patch}"


# ── File pattern matching ───────────────────────────────────────────────────

def matches_pattern(filepath, pattern):
    """Check if filepath matches a glob pattern using fnmatch semantics.

    Supports *, **, and ? patterns. Single * does not match across /.
    """
    if "**" in pattern:
        # Split on ** and match segments
        parts = pattern.split("**")
        if len(parts) == 2:
            prefix, suffix = parts
            prefix = prefix.rstrip("/")
            suffix = suffix.lstrip("/")
            if prefix and not filepath.startswith(prefix + "/") and filepath != prefix:
                return False
            if suffix:
                if prefix:
                    remaining = filepath[len(prefix):].lstrip("/")
                else:
                    remaining = filepath
                # Match suffix against the filename or any trailing path segment
                return fnmatch(remaining, suffix) or fnmatch(
                    remaining.split("/")[-1] if "/" in remaining else remaining,
                    suffix,
                )
            return True
    # For patterns without **, use path-aware matching:
    # Split both by / and match segment by segment
    if "/" in pattern:
        pat_parts = pattern.split("/")
        file_parts = filepath.split("/")
        if len(pat_parts) != len(file_parts):
            return False
        return all(fnmatch(fp, pp) for fp, pp in zip(file_parts, pat_parts))
    # Simple pattern (no /) — only matches top-level files
    # (single * must not match across /)
    if "/" in filepath:
        return False
    return fnmatch(filepath, pattern)


def check_files_changed(changed_files, patterns):
    """Check if any changed file matches any pattern.

    Returns list of (file, pattern) matches, or empty list.
    """
    matches = []
    for filepath in changed_files:
        for pattern in patterns:
            if matches_pattern(filepath, pattern):
                matches.append((filepath, pattern))
                break  # One match per file is enough
    return matches


# ── Git helpers ─────────────────────────────────────────────────────────────

def git(*args, check=True, capture=True, env=None):
    """Run a git command and return stdout.

    `env`, when given, is the whole environment of the command.
    """
    cmd = ["git"] + list(args)
    result = subprocess.run(
        cmd,
        capture_output=capture,
        text=True,
        check=False,
        env=env,
    )
    if check and result.returncode != 0:
        stderr = result.stderr.strip() if capture else ""
        raise SemverError(f"git {' '.join(args)} failed: {stderr}")
    return result


def get_changed_files(since):
    """Get list of files changed since the given commit."""
    if since == "0" * 40:
        # Initial commit — diff the tree
        result = git("diff-tree", "--no-commit-id", "--name-only", "-r", "HEAD")
    else:
        result = git("diff", "--name-only", since, "HEAD")
    return [f for f in result.stdout.strip().split("\n") if f]


def get_changed_files_between(base, head):
    """Files changed on `head` since it left `base` (`git diff base...head`).

    Three-dot, as git-cicd computes a pull request's changed files: only what
    the change under test did, not what landed on the base since.
    """
    result = git("diff", "--name-only", f"{base}...{head}")
    return [f for f in result.stdout.strip().split("\n") if f]


def read_version_at(rev, version_file):
    """The version file's content at `rev`, stripped, or None when absent."""
    result = git("show", f"{rev}:{version_file}", check=False)
    if result.returncode != 0:
        return None
    return result.stdout.strip()


def verify_commit(rev):
    """Raise SemverError unless `rev` names a commit."""
    if git("rev-parse", "--verify", "--quiet", f"{rev}^{{commit}}",
           check=False).returncode != 0:
        raise SemverError(f"not a commit: {rev}")


def get_commits_since_tag(tag=None, subdir=None):
    """Get commit messages since the last tag (or all if no tag).

    For subdirectories, uses <subdir>/v* tag pattern.
    """
    if tag is None:
        tag_match = f"{subdir}/v*" if subdir else "v*"
        result = git(
            "describe", "--tags", "--abbrev=0", "--match", tag_match,
            check=False,
        )
        tag = result.stdout.strip() if result.returncode == 0 else None

    if tag:
        result = git(
            "log", f"{tag}..HEAD", "--no-merges", "--pretty=format:%s",
        )
    else:
        result = git("log", "--no-merges", "--pretty=format:%s")
    return [line for line in result.stdout.strip().split("\n") if line]


# ── File updates ────────────────────────────────────────────────────────────

def apply_updates(updates, new_version):
    """Apply version updates to configured files."""
    for filepath, action in updates.items():
        path = Path(filepath)
        if not path.exists():
            print(f"Warning: {filepath} not found, skipping")
            continue
        if action == "file":
            path.write_text(new_version + "\n")
            print(f"Updated {filepath} (file)")
        elif isinstance(action, list):
            content = path.read_text()
            for pattern in action:
                if "=" in pattern:
                    # Backreference \1 ensures matching open/close quote is preserved
                    regex = re.escape(pattern) + r"""(["\']?)\d+\.\d+\.\d+\1"""

                    def _repl(m, _pat=pattern, _ver=new_version):
                        q = m.group(1)
                        return _pat + q + _ver + q

                    content = re.sub(regex, _repl, content)
                else:
                    regex = re.escape(pattern) + r"\d+\.\d+\.\d+"
                    replacement = pattern + new_version
                    content = re.sub(regex, replacement, content)
            path.write_text(content)
            print(f"Updated {filepath} (patterns)")


# ── Changelog ───────────────────────────────────────────────────────────────

def update_changelog(changelog_file, new_version, description=None,
                     ignore_prefixes=None, subdir=None):
    """Update changelog with a new version entry."""
    path = Path(changelog_file)
    if not path.exists():
        print(f"Warning: {changelog_file} not found, skipping changelog")
        return

    if description:
        commits_text = f"- {description}"
    else:
        commits = get_commits_since_tag(subdir=subdir)
        if ignore_prefixes:
            commits = [
                c for c in commits
                if not any(c.startswith(p) for p in ignore_prefixes)
            ]
        commits_text = "\n".join(f"- {c}" for c in commits) if commits else "- No notable changes"

    date = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    entry = f"## [{new_version}] - {date}\n\n### Changed\n{commits_text}\n\n"

    content = path.read_text()
    idx = content.find("\n## [")
    if idx >= 0:
        content = content[: idx + 1] + entry + content[idx + 1 :]
    else:
        content += "\n" + entry
    path.write_text(content)
    print(f"Updated {changelog_file}")


# ── Tag helpers ─────────────────────────────────────────────────────────────

def format_tag(version, subdir=None):
    """Format a version tag string."""
    if subdir:
        return f"{subdir}/v{version}"
    return f"v{version}"


def get_latest_tag_version(subdir=None):
    """Find the highest version from existing git tags.

    Used to detect when the VERSION file is behind the tag state
    (e.g., from a queued workflow run that already tagged, or an
    orphaned tag from a reverted commit).

    Returns (major, minor, patch) tuple or None if no matching tags.
    """
    pattern = f"{subdir}/v*" if subdir else "v[0-9]*"
    result = git("tag", "-l", pattern, check=False)
    if result.returncode != 0 or not result.stdout.strip():
        return None
    prefix = f"{subdir}/v" if subdir else "v"
    versions = []
    for tag in result.stdout.strip().split("\n"):
        if not tag.startswith(prefix):
            continue
        version_str = tag[len(prefix):]
        try:
            versions.append(parse_version(version_str))
        except SemverError:
            continue
    return max(versions) if versions else None


# ── Core bump logic ────────────────────────────────────────────────────────

def bump_component(config, subdir=None, bump_type="patch", description=None):
    """Bump version for a single component (root or subdirectory).

    Updates version file, applies file updates, updates changelog.
    Returns (subdir, old_version, new_version, tag_name).
    """
    if subdir:
        effective = get_subdir_config(config, subdir)
    else:
        effective = config

    version_file = get_version_file(effective)
    current = read_version(version_file)
    major, minor, patch = parse_version(current)

    # Use the higher of VERSION file or latest tag as baseline.
    # Handles queued CI runs where a previous run already tagged a higher
    # version, or orphaned tags from reverted/force-pushed commits.
    latest_tag = get_latest_tag_version(subdir)
    if latest_tag and latest_tag > (major, minor, patch):
        baseline = format_version(*latest_tag)
        print(f"Note: tag {format_tag(baseline, subdir)} exists ahead of "
              f"VERSION file ({current}), using as baseline")
        major, minor, patch = latest_tag

    new_major, new_minor, new_patch = compute_new_version(major, minor, patch, bump_type)
    new_version = format_version(new_major, new_minor, new_patch)
    tag = format_tag(new_version, subdir)

    label = subdir or "root"
    print(f"Bumping {label} ({bump_type}): {current} -> {new_version}")

    # Write version file
    Path(version_file).write_text(new_version + "\n")
    print(f"Updated {version_file}")

    # Apply updates
    apply_updates(effective.get("updates", {}), new_version)

    # Update changelog
    cl_enabled, cl_file, cl_ignore = parse_changelog_config(config, subdir)
    if cl_enabled:
        update_changelog(cl_file, new_version, description, cl_ignore, subdir=subdir)

    return subdir, current, new_version, tag


# ── Labels ──────────────────────────────────────────────────────────────────
#
# git-deps.labels.json, at the repository root, says what the publisher
# knows about released versions (README "Labels (git-deps.labels.json)").
# Reading is strict about structure and tolerant about content: an unknown
# label name, label field or top-level key is kept and written back as read.

LABELS_FILE = "git-deps.labels.json"
LABELS_FORMAT = 1
# Label fields in the order they are written; unknown fields follow them.
LABEL_FIELDS = ("name", "reason", "date", "commit", "fixed_in")
COMMIT_SHA_RE = re.compile(r"^[0-9a-f]{40}$")
LABEL_DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")


def empty_labels():
    """The content of a labels file with no labels."""
    return {"format": LABELS_FORMAT, "versions": {}}


def split_version_tag(tag):
    """Split a version tag into (component, (major, minor, patch)).

    The component is None for the root (`vX.Y.Z`) and the subdirectory for
    `<subdir>/vX.Y.Z`. Raises SemverError for anything else.
    """
    if not isinstance(tag, str) or not VERSION_TAG_RE.fullmatch(tag):
        raise SemverError(f"not a version tag: {tag!r}")
    component, _, version = tag.rpartition("/")
    return component or None, parse_version(version[1:])


def version_tag_sort_key(tag):
    """Root first, then subdirectories by name; versions by precedence."""
    component, version = split_version_tag(tag)
    return (component is not None, component or "", version)


def _check_label(label, where):
    """Raise SemverError unless `label` is a structurally valid label."""
    if not isinstance(label, dict):
        raise SemverError(f"{where}: a label must be an object")
    name = label.get("name")
    if not isinstance(name, str) or not name:
        raise SemverError(f"{where}: 'name' must be a non-empty string")
    commit = label.get("commit")
    if not isinstance(commit, str) or not COMMIT_SHA_RE.match(commit):
        raise SemverError(f"{where}: 'commit' must be a 40-hex commit sha")
    date = label.get("date")
    valid_date = isinstance(date, str) and LABEL_DATE_RE.match(date)
    if valid_date:
        try:
            datetime.strptime(date, "%Y-%m-%d")
        except ValueError:
            valid_date = False
    if not valid_date:
        raise SemverError(f"{where}: 'date' must be a YYYY-MM-DD date")
    if "reason" in label:
        reason = label["reason"]
        if not isinstance(reason, str) or "\n" in reason or "\r" in reason:
            raise SemverError(f"{where}: 'reason' must be a one-line string")
    if "fixed_in" in label:
        fixed_in = label["fixed_in"]
        if not isinstance(fixed_in, str) or _try_parse_version(fixed_in) is None:
            raise SemverError(f"{where}: 'fixed_in' must be an X.Y.Z version")


def parse_labels(text, source=LABELS_FILE):
    """Parse and check the text of a labels file; returns its content.

    Raises SemverError naming what is wrong, and where, when the structure
    is not format 1. Unknown label names, label fields and top-level keys
    are kept.
    """
    try:
        data = json.loads(text)
    except json.JSONDecodeError as e:
        raise SemverError(f"{source}: invalid JSON: {e}")
    if not isinstance(data, dict):
        raise SemverError(f"{source}: the top level must be an object")
    if "format" not in data:
        raise SemverError(f"{source}: 'format' is missing")
    fmt = data["format"]
    if not isinstance(fmt, int) or isinstance(fmt, bool):
        raise SemverError(f"{source}: 'format' must be an integer")
    if fmt != LABELS_FORMAT:
        raise SemverError(
            f"{source}: format {fmt} is not supported (this git-semver reads "
            f"format {LABELS_FORMAT})"
        )
    if "versions" not in data:
        raise SemverError(f"{source}: 'versions' is missing")
    versions = data["versions"]
    if not isinstance(versions, dict):
        raise SemverError(f"{source}: 'versions' must be an object")
    for tag, labels in versions.items():
        if not VERSION_TAG_RE.fullmatch(tag):
            raise SemverError(
                f"{source}: versions[{tag!r}]: not a version tag "
                "(vX.Y.Z or <subdir>/vX.Y.Z)"
            )
        if not isinstance(labels, list):
            raise SemverError(f"{source}: versions[{tag!r}]: must be a list of labels")
        for i, label in enumerate(labels):
            _check_label(label, f"{source}: versions[{tag!r}][{i}]")
    return data


def load_labels(path=LABELS_FILE):
    """Read a labels file; a missing file reads as empty."""
    p = Path(path)
    if not p.exists():
        return empty_labels()
    return parse_labels(p.read_text(encoding="utf-8"), source=str(path))


def _canonical_label(label):
    """`label` with its known fields first, in LABEL_FIELDS order."""
    out = {k: label[k] for k in LABEL_FIELDS if k in label}
    out.update((k, v) for k, v in label.items() if k not in out)
    return out


def canonical_labels(data):
    """`data` in the order it is written.

    Top level: format, versions, then unknown keys as read. Versions by
    component (root first), then version precedence. Labels by name (a
    stable sort), fields in LABEL_FIELDS order, then unknown fields as read.
    """
    versions = data["versions"]
    out = {
        "format": data["format"],
        "versions": {
            tag: [_canonical_label(label)
                  for label in sorted(versions[tag], key=lambda lb: lb["name"])]
            for tag in sorted(versions, key=version_tag_sort_key)
        },
    }
    out.update((k, v) for k, v in data.items() if k not in out)
    return out


def dump_labels(data):
    """The text of a labels file holding `data`, in canonical form."""
    return json.dumps(canonical_labels(data), indent=2, ensure_ascii=False) + "\n"


def save_labels(path, data):
    """Write `data` to the labels file at `path` in canonical form."""
    Path(path).write_text(dump_labels(data), encoding="utf-8")


# ── Subcommands ─────────────────────────────────────────────────────────────

def cmd_version(args):
    """Print current version."""
    config = load_config(args.config)
    subdir = getattr(args, "subdir", None)

    if subdir:
        effective = get_subdir_config(config, subdir)
    else:
        effective = config

    version_file = get_version_file(effective)
    version = read_version(version_file)
    print(version)


def cmd_check(args):
    """Check if a version bump is needed based on changed files.

    Returns 0 if bump needed, 1 if not.
    """
    config = load_config(args.config)
    subdir = getattr(args, "subdir", None)
    since = args.since or "HEAD~1"

    if subdir:
        effective = get_subdir_config(config, subdir)
    else:
        effective = config

    patterns = effective.get("files")
    if not patterns:
        raise SemverError(
            "No 'files' patterns configured"
            + (f" for '{subdir}'" if subdir else " for root config")
        )

    changed = get_changed_files(since)
    if not changed:
        print("No files changed")
        return 1

    matches = check_files_changed(changed, patterns)
    if matches:
        for filepath, pattern in matches:
            print(f"Matched: {filepath} (pattern: {pattern})")
        return 0
    else:
        print("No matching files changed")
        return 1


def _try_parse_version(version_str):
    """parse_version, or None when the string is missing or malformed."""
    if version_str is None:
        return None
    try:
        return parse_version(version_str)
    except SemverError:
        return None


def check_bump_component(changed, base, head, effective, subdir=None):
    """Check one component for cmd_check_bump.

    Returns (ok, lines, fixable). `fixable` is True only when the component
    failed because its version is unchanged from the base's, the one case
    fixing mode raises by a patch; a version that went down, is malformed or
    is missing is an error, never fixed.
    """
    label = subdir or "root"
    patterns = effective.get("files")
    if not patterns:
        return True, [f"{label}: skipped (no 'files' configured)"], False

    version_file = get_version_file(effective)
    matches = check_files_changed(changed, patterns)
    version_file_changed = version_file in changed
    if not matches and not version_file_changed:
        return True, [f"{label}: no configured file changed"], False

    base_version = read_version_at(base, version_file)
    head_version = read_version_at(head, version_file)
    base_tuple = _try_parse_version(base_version)
    head_tuple = _try_parse_version(head_version)

    if head_tuple is not None and (base_tuple is None or head_tuple > base_tuple):
        shown_base = base_version if base_tuple is not None else "none"
        return True, [f"{label}: version raised {shown_base} -> {head_version} "
                      f"({version_file})"], False

    if matches:
        files = ", ".join(f for f, _ in matches)
        why = f"configured files changed ({files})"
    else:
        why = f"{version_file} changed"
    fixable = False
    if head_version is None:
        found = f"{version_file} is missing"
    elif head_tuple is None:
        found = f"{version_file} holds {head_version!r}, not a valid X.Y.Z version"
    elif head_tuple == base_tuple:
        found = f"{version_file} is still {head_version}"
        fixable = True
    else:
        found = f"{version_file} went down to {head_version}"
    return False, [
        f"{label}: FAIL: {why}, but the version was not raised: {found} "
        f"(base {base} has {base_version if base_version is not None else 'no version'})",
        f"  fix: run `{bump_fix_command(subdir)}` on the branch and push the commit "
        "(minor or major instead of patch are accepted too)",
    ], fixable


def bump_fix_command(subdir=None):
    """The command a person runs to make the bump check-bump asks for."""
    fix = "git-semver bump patch --no-push"
    if subdir:
        fix += f" --subdir {subdir}"
    return fix


def resolve_fix_mode(args, config):
    """Whether check-bump runs in fixing mode.

    --fix / --no-fix win. Otherwise the `push_bump` key decides, and it only
    applies with `"bump_on": "pull_request"`, where it defaults to true.
    """
    forced = getattr(args, "fix", None)
    if forced is not None:
        return bool(forced)
    if config.get("bump_on") != "pull_request":
        return False
    return bool(config.get("push_bump", True))


def bump_written_paths(config, subdir=None):
    """The files bump_component writes for a component, as it will write them.

    The version file always; each `updates` target that exists; the changelog
    file when the changelog is enabled and the file exists.
    """
    effective = get_subdir_config(config, subdir) if subdir else config
    paths = [get_version_file(effective)]
    paths += [f for f in effective.get("updates", {}) if Path(f).exists()]
    cl_enabled, cl_file, _ = parse_changelog_config(config, subdir)
    if cl_enabled and Path(cl_file).exists():
        paths.append(cl_file)
    return paths


def commit_identity_args():
    """`-c` options naming a committer when git has none configured (CI)."""
    if git("config", "user.email", check=False).stdout.strip():
        return []
    return ["-c", "user.name=git-semver",
            "-c", "user.email=git-semver@users.noreply.github.com"]


def fix_missing_bumps(config, base, head, fixable):
    """Raise each fixable component by a patch and make one commit.

    The commit is made on top of `head`, which must be the checked-out HEAD,
    and holds only the files the bumps wrote. Returns (raised, sha) with
    raised a list of (label, old, new).
    """
    head_sha = git("rev-parse", f"{head}^{{commit}}").stdout.strip()
    checked_out = git("rev-parse", "HEAD").stdout.strip()
    if head_sha != checked_out:
        raise SemverError(
            f"fixing mode needs the commit under test checked out: head is "
            f"{head_sha}, HEAD is {checked_out} (check out the head, or pass "
            "--no-fix)"
        )

    raised = []
    paths = []
    for subdir in fixable:
        effective = get_subdir_config(config, subdir) if subdir else config
        base_tuple = parse_version(read_version_at(base, get_version_file(effective)))
        for path in bump_written_paths(config, subdir):
            if path not in paths:
                paths.append(path)
        _, old, new, _ = bump_component(config, subdir=subdir, bump_type="patch")
        assert parse_version(new) > base_tuple, (new, base_tuple)
        raised.append((subdir or "root", old, new))

    summary = ", ".join(f"{label} {old} -> {new}" for label, old, new in raised)
    message = f"chore: bump version ({summary})"
    git("add", "--", *paths)
    git(*commit_identity_args(), "commit", "-m", message)
    sha = git("rev-parse", "HEAD").stdout.strip()
    print(f"Committed {sha}: {message}")
    return raised, sha


# ── Pushing the fix ─────────────────────────────────────────────────────────

PUSH_REMOTE = "origin"
TOKEN_HEADER_KEY = "http.https://github.com/.extraheader"


def token_header(token):
    """The extraheader value actions/checkout writes for a token."""
    basic = base64.b64encode(f"x-access-token:{token}".encode()).decode()
    return f"AUTHORIZATION: basic {basic}"


def token_git_env(token):
    """An environment that gives git `token` for github.com and nothing else.

    The token travels as config in GIT_CONFIG_* variables, never on the
    command line or in .git/config. The first, empty entry resets the
    extraheader actions/checkout persisted (with GITHUB_TOKEN, whose pushes
    start no workflow), the second adds the token's.
    """
    env = dict(os.environ)
    env.update({
        "GIT_TERMINAL_PROMPT": "0",
        "GIT_CONFIG_COUNT": "2",
        "GIT_CONFIG_KEY_0": TOKEN_HEADER_KEY,
        "GIT_CONFIG_VALUE_0": "",
        "GIT_CONFIG_KEY_1": TOKEN_HEADER_KEY,
        "GIT_CONFIG_VALUE_1": token_header(token),
    })
    return env


def redact(text, token):
    """`text` with the token, its basic-auth form and its header removed."""
    basic = token_header(token).split(" ", 2)[2]
    for secret in (basic, token):
        text = text.replace(secret, "***")
    return text


def is_release_branch(branch, target):
    """The branches that are released from: the target, main and master."""
    return branch in {target, "main", "master"}


def push_refusal(token, source, target, head_sha, env):
    """Why the fix commit may not be pushed to `source`, or None."""
    if not token:
        return "no CICD_WRITE_TOKEN: declare it on the version check job"
    if not source:
        return ("source branch unknown: pass --source-branch or set "
                "CICD_SOURCE_BRANCH")
    if source == target:
        return f"source branch {source} is the target branch"
    if is_release_branch(source, target):
        return f"source branch {source} is a release branch"
    result = git("ls-remote", "--heads", PUSH_REMOTE, f"refs/heads/{source}",
                 check=False, env=env)
    if result.returncode != 0:
        return (f"cannot read {PUSH_REMOTE}: "
                f"{redact(result.stderr.strip(), token)}")
    remote_sha = result.stdout.split("\t", 1)[0].strip()
    if not remote_sha:
        return (f"branch {source} is not on {PUSH_REMOTE} (a fork's branch "
                "is not pushed to)")
    if remote_sha != head_sha:
        return f"branch {source} moved on from {head_sha} (now {remote_sha})"
    return None


def push_fix(raised, sha, head_sha, args):
    """Push the fix commit to the pull request's source branch, if allowed.

    Prints what happened; the token never appears in the output. Returns
    True when pushed.
    """
    token = os.environ.get("CICD_WRITE_TOKEN", "")
    source = (getattr(args, "source_branch", None)
              or os.environ.get("CICD_SOURCE_BRANCH", ""))
    target = (getattr(args, "target_branch", None)
              or os.environ.get("CICD_TARGET_BRANCH", ""))
    env = token_git_env(token) if token else None

    reason = push_refusal(token, source, target, head_sha, env)
    if reason is None:
        result = git("push", PUSH_REMOTE, f"HEAD:refs/heads/{source}",
                     check=False, env=env)
        if result.returncode == 0:
            print(f"Pushed {sha} to {source}")
            print(f"The pushed commit {sha} starts its own run; wait for "
                  "that one")
            return True
        output = (result.stderr.strip() or result.stdout.strip())
        reason = f"git push failed: {redact(output, token)}"

    print(f"Not pushing the bump: {reason}")
    for label, _, _ in raised:
        command = bump_fix_command(None if label == "root" else label)
        print(f"  fix: run `{command}` on the branch and push the commit")
    return False


def cmd_check_bump(args):
    """Fail when the change under test touches configured files without
    raising the version; in fixing mode, also make the missing bump.

    Compares `head` with `base` (--base/--head, else CICD_BASE/CICD_HEAD;
    head defaults to HEAD) for the root and every subdirectory component.
    The check itself is local and needs no token or network.

    Fixing mode (--fix/--no-fix, else `push_bump`, default on with
    `"bump_on": "pull_request"`): when every failing component failed only
    because its version equals the base's, each is raised by a patch the
    way `bump` does it and one commit is made on top of the checked-out
    head. A component already raised by any amount is left alone. A version
    that went down, is malformed or is missing is an error and no commit is
    made at all.

    The fix commit is then pushed to the pull request's source branch
    (--source-branch/--target-branch, else CICD_SOURCE_BRANCH/
    CICD_TARGET_BRANCH) with CICD_WRITE_TOKEN, never forced. It is not
    pushed, with a reason and the command to run, when there is no token,
    no source branch, or the source branch is the target or a release
    branch, is not on origin (a fork) or moved on from the head.

    Returns 0 when every component passes, 1 otherwise (including when a
    fix commit was made or pushed: the commit under test still lacked the
    bump, and the pushed commit's own run is the one that can pass).
    """
    config = load_config(args.config)
    base = getattr(args, "base", None) or os.environ.get("CICD_BASE", "")
    head = getattr(args, "head", None) or os.environ.get("CICD_HEAD", "") or "HEAD"
    if not base:
        raise SemverError(
            "no base to compare with: pass --base <rev> or set CICD_BASE"
        )
    verify_commit(base)
    verify_commit(head)

    changed = get_changed_files_between(base, head)
    components = [(None, config)] + list(get_subdirectories(config).items())
    ok = True
    fixable = []
    unfixable = []
    for subdir, effective in components:
        passed, lines, can_fix = check_bump_component(
            changed, base, head, effective, subdir)
        ok = ok and passed
        if not passed:
            (fixable if can_fix else unfixable).append(subdir)
        for line in lines:
            print(line)
    if ok:
        return 0
    if not resolve_fix_mode(args, config):
        return 1
    if unfixable:
        names = ", ".join(s or "root" for s in unfixable)
        print(f"Not fixing: the version of {names} went down, is malformed "
              "or is missing; fix it by hand")
        return 1

    head_sha = git("rev-parse", f"{head}^{{commit}}").stdout.strip()
    raised, sha = fix_missing_bumps(config, base, head, fixable)
    for label, old, new in raised:
        print(f"Raised {label}: {old} -> {new}")
    print(f"Made commit {sha} with the missing bump; the commit under test "
          "still lacked it")
    push_fix(raised, sha, head_sha, args)
    return 1


def push_tags(tags):
    """Push each of `tags` to origin by name, never forced.

    Not `git push --tags`: that would also push any other local tag, such
    as a stale `latest`, and fail on "would clobber existing tag".
    """
    for tag in tags:
        git("push", PUSH_REMOTE, tag, check=True)


def cmd_bump(args):
    """Bump version, update files, commit, tag, push."""
    config = load_config(args.config)
    subdir = getattr(args, "subdir", None)
    bump_type = args.bump_type or "patch"

    _, _, new_version, tag = bump_component(
        config, subdir=subdir, bump_type=bump_type, description=args.description
    )

    if args.no_commit:
        print(f"\nVersion bumped to {new_version} (files only, no commit)")
        return

    # Commit
    git("add", "-A")
    git("commit", "-m", f"chore: bump version to {tag}")
    print(f"Committed: chore: bump version to {tag}")

    if args.no_push:
        print(f"\nVersion bumped to {new_version} (no push)")
        return

    # Tag
    git("tag", "-a", tag, "-m", tag)
    print(f"Tagged: {tag}")

    # Push the commit, then the new tag by name (never forced, never --tags)
    git("push", check=True)
    push_tags([tag])
    print(f"\nVersion bumped to {new_version} and pushed")


def cmd_bump_all(args):
    """Check all components and bump those with changes since the given commit.

    Iterates root config (if it has files/updates) and all subdirectory configs.
    Produces a single commit with tags for each bumped component.
    """
    config = load_config(args.config)
    since = args.since
    if not since:
        raise SemverError("--since is required for bump-all")
    bump_type = args.bump_type or "patch"

    changed = get_changed_files(since)
    if not changed:
        print("No files changed")
        return

    bumps = []  # list of (subdir, old_ver, new_ver, tag)

    # Check root config
    if config.get("files"):
        matches = check_files_changed(changed, config["files"])
        if matches:
            for filepath, pattern in matches:
                print(f"Root matched: {filepath} (pattern: {pattern})")
            result = bump_component(
                config, subdir=None, bump_type=bump_type,
                description=args.description,
            )
            bumps.append(result)

    # Check subdirectories
    for name, subconfig in get_subdirectories(config).items():
        if subconfig.get("files"):
            matches = check_files_changed(changed, subconfig["files"])
            if matches:
                for filepath, pattern in matches:
                    print(f"{name} matched: {filepath} (pattern: {pattern})")
                result = bump_component(
                    config, subdir=name, bump_type=bump_type,
                    description=args.description,
                )
                bumps.append(result)

    if not bumps:
        print("No components triggered")
        return

    if args.no_commit:
        print(f"\nBumped {len(bumps)} component(s) (files only, no commit)")
        return

    # Single commit for all bumps
    tags = [tag for _, _, _, tag in bumps]
    tags_str = ", ".join(tags)
    git("add", "-A")
    git("commit", "-m", f"chore: bump version {tags_str}")
    print(f"Committed: chore: bump version {tags_str}")

    if args.no_push:
        print(f"\nBumped {len(bumps)} component(s) (no push)")
        return

    # Create tags
    for _, _, _, tag in bumps:
        git("tag", "-a", tag, "-m", tag)
    print(f"Tagged: {tags_str}")

    # Push the commit, then the new tags by name (never forced, never --tags)
    git("push", check=True)
    push_tags(tags)
    print(f"\nBumped {len(bumps)} component(s) and pushed")


def cmd_tag(args):
    """Create version tags from VERSION files.

    Reads the current version from each component's version_file and creates
    annotated tags. Idempotent: if the tag for a component's current version
    already exists (at any commit), it is skipped — this is the expected case
    in a monorepo where only the bumped component has a new version.
    """
    config = load_config(args.config)
    subdir = getattr(args, "subdir", None)

    components = []  # list of (subdir, version, tag_name)

    if subdir:
        effective = get_subdir_config(config, subdir)
        version = read_version(get_version_file(effective))
        components.append((subdir, version, format_tag(version, subdir)))
    else:
        # Root config (if it has a version_file)
        root_vf = get_version_file(config)
        if Path(root_vf).exists():
            version = read_version(root_vf)
            components.append((None, version, format_tag(version)))

        # All subdirectories
        for name, subconfig in get_subdirectories(config).items():
            vf = get_version_file(subconfig)
            if Path(vf).exists():
                version = read_version(vf)
                components.append((name, version, format_tag(version, name)))

    if not components:
        print("No version files found")
        return

    tags_created = []
    for comp_subdir, version, tag_name in components:
        # If a tag for this version already exists (at any commit), skip it.
        # In a monorepo only the bumped component has a new version; untouched
        # components still point at their prior tag, which is expected — not an error.
        result = git("tag", "-l", tag_name, check=False)
        if result.stdout.strip() == tag_name:
            label = comp_subdir or "root"
            print(f"Tag {tag_name} already exists ({label}), skipping")
            continue
        git("tag", "-a", tag_name, "-m", tag_name)
        label = comp_subdir or "root"
        print(f"Tagged {label}: {tag_name}")
        tags_created.append(tag_name)

    if not tags_created:
        print("No tags created")
        return

    tags_str = ", ".join(tags_created)
    print(f"Created tags: {tags_str}")

    if getattr(args, "push", False):
        push_tags(tags_created)
        print("Tags pushed")


# Tag names format_tag produces: v<X.Y.Z> (root) or <subdir>/v<X.Y.Z>.
VERSION_TAG_RE = re.compile(r"^(?:.+/)?v\d+\.\d+\.\d+$")


def cmd_released(args):
    """Print the version tags pointing at a commit (default HEAD), one per line.

    Read-only and local: needs no config, token or network. Prints nothing
    (exit 0) when no version was released at the commit. `latest` and any
    other non-version tag are never printed.
    """
    ref = getattr(args, "ref", None) or "HEAD"
    verify_commit(ref)
    result = git("tag", "--points-at", ref)
    tags = sorted(t for t in result.stdout.split("\n") if VERSION_TAG_RE.match(t))
    for tag in tags:
        print(tag)


# The one label git-semver makes; others in the file are kept, not made.
DEFECT_LABEL = "defect"


def labels_path():
    """git-deps.labels.json at the root of the working tree."""
    top = git("rev-parse", "--show-toplevel").stdout.strip()
    return Path(top) / LABELS_FILE


def version_arg(version):
    """'X.Y.Z' or 'vX.Y.Z' as (version string, tuple)."""
    plain = version[1:] if version.startswith("v") else version
    parsed = parse_version(plain)
    return format_version(*parsed), parsed


def tag_commit(tag):
    """The commit tag `tag` points at, or None when there is no such tag."""
    result = git("rev-parse", "--verify", "--quiet", f"refs/tags/{tag}^{{commit}}",
                 check=False)
    return result.stdout.strip() if result.returncode == 0 else None


def _commit_hint(path):
    print(f"Commit {path.name} and bring it to the default branch with a pull "
          "request; nothing was committed, tagged or pushed")


def cmd_label(args):
    """Label a released version in git-deps.labels.json (working tree only).

    The version must have a tag; the label records the commit it points at.
    Only `defect` is made, and it needs a one-line --reason. --fixed-in must
    be a tagged, higher version of the same component. Labelling again
    updates the reason (and fixed_in when given) and keeps date and commit.
    Never commits, tags, pushes or needs a token or the network.
    """
    subdir = getattr(args, "subdir", None)
    if args.name != DEFECT_LABEL:
        raise SemverError(
            f"git-semver makes only the {DEFECT_LABEL!r} label, not {args.name!r} "
            "(other labels in the file are kept and can be removed with unlabel)"
        )
    reason = (args.reason or "").strip()
    if not reason:
        raise SemverError(f"a {DEFECT_LABEL} label needs --reason \"...\"")
    if "\n" in reason or "\r" in reason:
        raise SemverError("--reason must be one line")

    version, parsed = version_arg(args.version)
    tag = format_tag(version, subdir)
    commit = tag_commit(tag)
    if commit is None:
        raise SemverError(f"no tag {tag}: only a released (tagged) version can be labelled")

    fixed_in = None
    if args.fixed_in:
        fixed_in, fixed_parsed = version_arg(args.fixed_in)
        fixed_tag = format_tag(fixed_in, subdir)
        if tag_commit(fixed_tag) is None:
            raise SemverError(f"--fixed-in {fixed_in}: no tag {fixed_tag}")
        if fixed_parsed <= parsed:
            raise SemverError(
                f"--fixed-in {fixed_in} is not higher than the labelled {version}")

    path = labels_path()
    data = load_labels(path)
    labels = data["versions"].setdefault(tag, [])
    existing = next((lb for lb in labels if lb["name"] == args.name), None)
    if existing is None:
        label = {
            "name": args.name,
            "reason": reason,
            "date": datetime.now(timezone.utc).strftime("%Y-%m-%d"),
            "commit": commit,
        }
        if fixed_in:
            label["fixed_in"] = fixed_in
        labels.append(label)
        action = f"Labelled {tag} {args.name}"
    else:
        existing["reason"] = reason
        if fixed_in:
            existing["fixed_in"] = fixed_in
        action = f"Updated {args.name} on {tag}"
    save_labels(path, data)
    print(f"{action} in {path.name}")
    _commit_hint(path)


def cmd_unlabel(args):
    """Remove a label from a version in git-deps.labels.json.

    Any name can be removed and the tag need not exist. A version left with
    no labels is dropped; a file left with nothing else is deleted. When
    there was no such label it says so and exits 0.
    """
    subdir = getattr(args, "subdir", None)
    version, _ = version_arg(args.version)
    tag = format_tag(version, subdir)
    path = labels_path()
    data = load_labels(path)
    labels = data["versions"].get(tag, [])
    index = next((i for i, lb in enumerate(labels) if lb["name"] == args.name), None)
    if index is None:
        print(f"No {args.name} label on {tag}")
        return 0
    del labels[index]
    if not labels:
        del data["versions"][tag]
    if not data["versions"] and set(data) == {"format", "versions"}:
        path.unlink()
    else:
        save_labels(path, data)
    print(f"Removed {args.name} from {tag} in {path.name}")
    _commit_hint(path)
    return 0


def format_label_line(tag, label):
    """One readable line for a label."""
    parts = [tag, label["name"], label["date"], label["commit"][:7]]
    if "fixed_in" in label:
        parts.append(f"fixed in {label['fixed_in']}")
    line = "  ".join(parts)
    if label.get("reason"):
        line += f"  \u2014 {label['reason']}"
    return line


def cmd_labels(args):
    """List the labels in git-deps.labels.json, all or one version's.

    One readable line per label in the file's canonical order, or with
    --json the (filtered) content in canonical form. --subdir alone lists
    one component. Prints nothing when there are none.
    """
    subdir = getattr(args, "subdir", None)
    data = canonical_labels(load_labels(labels_path()))
    versions = data["versions"]
    if getattr(args, "version", None):
        version, _ = version_arg(args.version)
        tag = format_tag(version, subdir)
        versions = {t: v for t, v in versions.items() if t == tag}
    elif subdir:
        versions = {t: v for t, v in versions.items()
                    if split_version_tag(t)[0] == subdir}
    data["versions"] = versions
    if getattr(args, "json", False):
        print(dump_labels(data), end="")
        return 0
    for tag, labels in versions.items():
        for label in labels:
            print(format_label_line(tag, label))
    return 0


# ── CLI ─────────────────────────────────────────────────────────────────────

def build_parser():
    """Build the argument parser."""
    parser = argparse.ArgumentParser(
        description="Config-driven semantic versioning for git repos",
        prog="git-semver",
    )
    parser.add_argument(
        "--config", default=None,
        help=f"Config file path (default: {CONFIG_PATH})",
    )
    subparsers = parser.add_subparsers(dest="command")

    # version
    version_parser = subparsers.add_parser("version", help="Print current version")
    version_parser.add_argument("--subdir", default=None, help="Subdirectory name")

    # check
    check_parser = subparsers.add_parser("check", help="Check if bump is needed")
    check_parser.add_argument("--since", default=None, help="Commit ref to diff since")
    check_parser.add_argument("--subdir", default=None, help="Subdirectory name")

    # bump
    bump_parser = subparsers.add_parser("bump", help="Bump version")
    bump_parser.add_argument(
        "bump_type", nargs="?", default="patch",
        choices=["patch", "minor", "major"],
        help="Bump type (default: patch)",
    )
    bump_parser.add_argument("--subdir", default=None, help="Subdirectory name")
    bump_parser.add_argument("--description", default=None, help="Changelog description override")
    bump_parser.add_argument("--no-push", action="store_true", help="Skip tag and push")
    bump_parser.add_argument("--no-commit", action="store_true", help="Skip commit and push")

    # bump-all
    bump_all_parser = subparsers.add_parser(
        "bump-all", help="Check and bump all triggered components",
    )
    bump_all_parser.add_argument(
        "bump_type", nargs="?", default="patch",
        choices=["patch", "minor", "major"],
        help="Bump type (default: patch)",
    )
    bump_all_parser.add_argument(
        "--since", required=True, help="Commit ref to diff since",
    )
    bump_all_parser.add_argument(
        "--description", default=None, help="Changelog description override",
    )
    bump_all_parser.add_argument("--no-push", action="store_true", help="Skip tag and push")
    bump_all_parser.add_argument(
        "--no-commit", action="store_true", help="Skip commit and push",
    )

    # tag
    tag_parser = subparsers.add_parser("tag", help="Create version tags from VERSION files")
    tag_parser.add_argument("--push", action="store_true", help="Push tags after creation")
    tag_parser.add_argument("--subdir", default=None, help="Subdirectory name (tags all if omitted)")

    # released
    released_parser = subparsers.add_parser(
        "released", help="Print the version tags released at a commit",
    )
    released_parser.add_argument(
        "ref", nargs="?", default="HEAD", help="Commit to ask about (default: HEAD)",
    )

    # label / unlabel / labels
    label_parser = subparsers.add_parser(
        "label", help=f"Label a released version in {LABELS_FILE}",
    )
    label_parser.add_argument("version", help="Released version (X.Y.Z or vX.Y.Z)")
    label_parser.add_argument("name", help=f"Label name (only {DEFECT_LABEL!r})")
    label_parser.add_argument("--reason", default=None, help="Why, in one line (required)")
    label_parser.add_argument(
        "--fixed-in", default=None, help="Tagged, higher version that fixes it",
    )
    label_parser.add_argument("--subdir", default=None, help="Subdirectory name")

    unlabel_parser = subparsers.add_parser(
        "unlabel", help=f"Remove a label from a version in {LABELS_FILE}",
    )
    unlabel_parser.add_argument("version", help="Version (X.Y.Z or vX.Y.Z)")
    unlabel_parser.add_argument("name", help="Label name")
    unlabel_parser.add_argument("--subdir", default=None, help="Subdirectory name")

    labels_parser = subparsers.add_parser(
        "labels", help=f"List the labels in {LABELS_FILE}",
    )
    labels_parser.add_argument(
        "version", nargs="?", default=None, help="Only this version (X.Y.Z or vX.Y.Z)",
    )
    labels_parser.add_argument("--subdir", default=None, help="Subdirectory name")
    labels_parser.add_argument("--json", action="store_true", help="Print JSON")

    # check-bump
    check_bump_parser = subparsers.add_parser(
        "check-bump",
        help="Fail when configured files changed but the version was not raised",
    )
    check_bump_parser.add_argument(
        "--base", default=None,
        help="Commit to compare with (default: $CICD_BASE)",
    )
    check_bump_parser.add_argument(
        "--head", default=None,
        help="Commit under test (default: $CICD_HEAD, else HEAD)",
    )
    fix_group = check_bump_parser.add_mutually_exclusive_group()
    fix_group.add_argument(
        "--fix", dest="fix", action="store_true", default=None,
        help="Raise a missing version by a patch and commit it (default: "
             "push_bump, on with bump_on pull_request)",
    )
    fix_group.add_argument(
        "--no-fix", dest="fix", action="store_false",
        help="Check only: never commit a bump",
    )
    check_bump_parser.add_argument(
        "--source-branch", default=None,
        help="Pull request branch the fix is pushed to "
             "(default: $CICD_SOURCE_BRANCH)",
    )
    check_bump_parser.add_argument(
        "--target-branch", default=None,
        help="Branch the pull request goes into (default: $CICD_TARGET_BRANCH)",
    )

    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(1)

    commands = {
        "version": cmd_version,
        "check": cmd_check,
        "bump": cmd_bump,
        "bump-all": cmd_bump_all,
        "tag": cmd_tag,
        "released": cmd_released,
        "label": cmd_label,
        "unlabel": cmd_unlabel,
        "labels": cmd_labels,
        "check-bump": cmd_check_bump,
    }

    try:
        result = commands[args.command](args)
        if isinstance(result, int):
            sys.exit(result)
    except SemverError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
