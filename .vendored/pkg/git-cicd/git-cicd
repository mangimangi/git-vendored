#!/usr/bin/env python3
"""git-cicd - decide which jobs a change needs, run them, and report.

A repository declares jobs in .vendored/configs/git-cicd.json. Each job is a
setup script and ordered steps, every one a plain file the repository owns.
git-cicd knows nothing about what the checks are: it decides from a change
which jobs are needed, runs them, and reports every decision, so that
"nothing ran" is never read as "passed".

Python 3 standard library and the git CLI only.

Subcommands:
  validate   load and validate the config
  decide     decide which jobs a change needs on a trigger
  run-job    run one job: setup when asked, then its steps
  generate   write the generated workflows (one per trigger) from the config
  verify     check that the generated workflows match the config
  report     one line per job with times, and one verdict
  check      decide, run and report locally, without GitHub
"""

import argparse
import difflib
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
import time

CONFIG_PATH = ".vendored/configs/git-cicd.json"
# One generated workflow per trigger: (workflow name, file). The names and the
# files are fixed for good, so no adopter has to rename a file again. Only the
# triggers in GENERATED_TRIGGERS are written; adding one adds its template under
# templates/workflows/ and its word here, and changes no other file.
WORKFLOWS = {
    "open": ("Open", ".github/workflows/git-cicd-open.yml"),
    "merge": ("Merge", ".github/workflows/git-cicd-merge.yml"),
    "cron": ("Cron", ".github/workflows/git-cicd-cron.yml"),
    "manual": ("Manual", ".github/workflows/git-cicd-manual.yml"),
}
GENERATED_TRIGGERS = ("open", "merge", "cron", "manual")
# The single workflow file of git-cicd before the per-trigger files; generate
# removes it and verify fails while it is there.
LEGACY_WORKFLOW_PATH = ".github/workflows/git-cicd.yml"
TEMPLATE_DIR = os.path.join("templates", "workflows")

# The commit status a reader waits on, named `<name> / <owner>:<job>` like
# every row (git-cicd's own rows, in the templates, are
# `Decide / git-cicd:decide` and `Report / git-cicd:report`).
VERDICT_STATUS = "Verdict / git-cicd:verdict"

TRIGGERS = ("open", "merge", "cron")
DEFAULT_MAX_PARALLEL = 3

TOP_LEVEL_FIELDS = ("_vendor", "jobs", "needs_nothing", "max_parallel")
JOB_FIELDS = ("name", "on", "branches", "paths", "setup", "steps", "cron", "manual",
              "blocking", "inputs")
INPUT_FIELDS = ("description", "required", "default", "choices")

JOB_NAME_RE = re.compile(r"^[A-Za-z0-9_-]+$")
INPUT_NAME_RE = re.compile(r"^[a-z][a-z0-9_]*$")
# Every declared input reaches a script as CICD_INPUT_<NAME upper-cased>.
INPUT_ENV_PREFIX = "CICD_INPUT_"
# The values of a manual run: a JSON object of strings, set by the Manual
# workflow from its fixed `inputs` field. Read by the tool, never passed on.
MANUAL_INPUTS_ENV = "CICD_MANUAL_INPUTS"
GLOB_CHARS = ("*", "?", "[")


class ConfigError(Exception):
    """The config breaks the interface. Carries every error found."""

    def __init__(self, errors):
        self.errors = list(errors)
        super().__init__("\n".join(self.errors))


class UsageError(Exception):
    """A request the tool refuses (exit 2)."""


def default_title(name):
    """The display name of a job without `name`: its job name with `-` and
    `_` as spaces and each word capitalised (`unit-tests` -> `Unit Tests`).
    A `name` the repository wrote is never passed through this."""
    words = [w for w in re.split(r"[-_]+", name) if w]
    return " ".join(w[:1].upper() + w[1:] for w in words) or name


# ── Patterns ────────────────────────────────────────────────────────────────

_PATTERN_CACHE = {}


def compile_pattern(pattern):
    """Compile a glob pattern to a regex.

    `**` matches any sequence including `/` (`dir/**` matches everything
    under dir; a `**/` segment may also match no directory at all), `*`
    matches any sequence without `/`, `?` matches one character other than
    `/`. Everything else is literal. fnmatch is not used: its `*` crosses `/`.
    """
    cached = _PATTERN_CACHE.get(pattern)
    if cached is not None:
        return cached
    out = []
    i = 0
    n = len(pattern)
    while i < n:
        c = pattern[i]
        if c == "*":
            if i + 1 < n and pattern[i + 1] == "*":
                at_segment_start = i == 0 or pattern[i - 1] == "/"
                if at_segment_start and i + 2 < n and pattern[i + 2] == "/":
                    out.append("(?:.*/)?")
                    i += 3
                else:
                    out.append(".*")
                    i += 2
            else:
                out.append("[^/]*")
                i += 1
        elif c == "?":
            out.append("[^/]")
            i += 1
        else:
            out.append(re.escape(c))
            i += 1
    regex = re.compile("".join(out) + r"\Z", re.DOTALL)
    _PATTERN_CACHE[pattern] = regex
    return regex


def match(pattern, path):
    """True when path matches the glob pattern as a whole."""
    return compile_pattern(pattern).match(path) is not None


def match_any(patterns, path):
    return any(match(p, path) for p in patterns)


# ── Repository ──────────────────────────────────────────────────────────────

def git(*args, cwd=None, check=False):
    """Run git with a list argv (never through a shell)."""
    return subprocess.run(["git", *args], cwd=cwd, capture_output=True,
                          text=True, check=check)


def repo_root(cwd=None):
    result = git("rev-parse", "--show-toplevel", cwd=cwd)
    if result.returncode != 0:
        raise UsageError("not inside a git repository: "
                         + result.stderr.strip())
    return result.stdout.strip()


# ── Config ──────────────────────────────────────────────────────────────────

def _is_str_list(value):
    return isinstance(value, list) and all(isinstance(v, str) for v in value)


def _check_file(root, path, where):
    """Errors for a setup or step file: a repository path to an executable
    regular file, relative, without `..` segments."""
    if path == "":
        return [f"{where}: empty path"]
    if os.path.isabs(path):
        return [f"{where}: {path} is an absolute path; use a path relative "
                "to the repository root"]
    if ".." in path.replace("\\", "/").split("/"):
        return [f"{where}: {path} contains a '..' segment"]
    full = os.path.join(root, path)
    if not os.path.isfile(full):
        return [f"{where}: {path} is not a file in the repository"]
    if not os.access(full, os.X_OK):
        return [f"{where}: {path} is not executable (chmod +x it)"]
    return []


def _validate_step(root, step, where):
    if isinstance(step, str):
        if step.strip() != step or any(ch.isspace() for ch in step):
            return [f"{where}: {step!r} contains whitespace; a step is a file "
                    "plus fixed arguments, never a shell command line - use "
                    "the array form [\"file\", \"arg\", ...]"]
        return _check_file(root, step, where)
    if isinstance(step, list):
        if not step:
            return [f"{where}: empty array; a step is a file plus fixed "
                    "arguments"]
        if not _is_str_list(step):
            return [f"{where}: every element of an array step must be a "
                    "string"]
        return _check_file(root, step[0], where)
    return [f"{where}: a step must be a file (string) or an array of a file "
            "and fixed arguments"]


def _validate_inputs(prefix, inputs):
    """Return (errors, normalized inputs) for a job's `inputs` field: input
    name -> {description, required, default, choices}. Every value is a
    string, since values reach scripts as environment variables."""
    if not isinstance(inputs, dict):
        return [f"{prefix}: inputs must be an object (input name -> "
                "declaration)"], {}
    errors = []
    normalized = {}
    for name, decl in inputs.items():
        where = f"{prefix}: input {name}"
        before = len(errors)
        if not INPUT_NAME_RE.match(name):
            errors.append(f"{where}: invalid input name (lowercase letters, "
                          "digits and _, starting with a letter)")
        if not isinstance(decl, dict):
            errors.append(f"{where}: a declaration must be an object "
                          f"({', '.join(INPUT_FIELDS)})")
            continue
        for key in decl:
            if key not in INPUT_FIELDS:
                errors.append(f"{where}: unknown field {key}")
        description = decl.get("description", "")
        if not isinstance(description, str) or not all(
                ch.isprintable() for ch in description):
            errors.append(f"{where}: description must be a single-line "
                          "string of printable characters")
        required = decl.get("required", False)
        if not isinstance(required, bool):
            errors.append(f"{where}: required must be a boolean")
        default = decl.get("default")
        if "default" in decl and not isinstance(default, str):
            errors.append(f"{where}: default must be a string (every input "
                          "value is a string)")
        if required is True and "default" in decl:
            errors.append(f"{where}: a required input cannot have a default "
                          "(leave required out, or drop the default)")
        choices = decl.get("choices")
        if "choices" in decl:
            if not isinstance(choices, list) or not choices:
                errors.append(f"{where}: choices must be a non-empty array "
                              "of strings")
            elif not _is_str_list(choices):
                errors.append(f"{where}: every choice must be a string")
            else:
                for dupe in sorted({c for c in choices
                                    if choices.count(c) > 1}):
                    errors.append(f"{where}: choice {dupe!r} is listed more "
                                  "than once")
                if isinstance(default, str) and default not in choices:
                    errors.append(f"{where}: default {default!r} is not one "
                                  f"of the choices ({', '.join(choices)})")
        if len(errors) == before:
            normalized[name] = {
                "description": description,
                "required": required,
                "default": default,
                "choices": list(choices) if choices is not None else None,
            }
    return errors, normalized


def input_env_name(name):
    return INPUT_ENV_PREFIX + name.upper()


def parse_manual_inputs(text):
    """The values of a manual run from the Manual workflow's `inputs` field
    (a JSON object of strings; empty means none). Return (values, None) or
    (None, why)."""
    if text is None or not text.strip():
        return {}, None
    try:
        data = json.loads(text)
    except ValueError as e:
        return None, f"the inputs are not valid JSON ({e})"
    if not isinstance(data, dict) or not all(
            isinstance(v, str) for v in data.values()):
        return None, ("the inputs must be a JSON object of string values, "
                      'for example {"bump_type": "minor"}')
    return data, None


def input_values(job, given=None):
    """Every declared input's value: the given one, else the default, else
    the empty string. Return (values, None) or (None, why) when a given value
    is undeclared or outside the choices, or a required input is missing.
    With `given` None (every trigger but manual) nothing is required: each
    input is its default or the empty string."""
    manual = given is not None
    given = given or {}
    declared = job.get("inputs") or {}
    name = job["name"]
    for key in given:
        if key not in declared:
            return None, (f"job {name} declares no input {key!r} (declared: "
                          f"{', '.join(declared) or 'none'})")
    values = {}
    for key, decl in declared.items():
        if key in given:
            value = given[key]
            if decl["choices"] is not None and value not in decl["choices"]:
                return None, (f"job {name}: input {key}: {value!r} is not "
                              f"one of the choices "
                              f"({', '.join(decl['choices'])})")
        elif decl["required"] and manual:
            return None, f"job {name}: input {key} is required"
        else:
            value = decl["default"] if decl["default"] is not None else ""
        values[key] = value
    return values, None


def manual_input_values(job):
    """The values of a manual run of the job, from MANUAL_INPUTS_ENV."""
    given, why = parse_manual_inputs(os.environ.get(MANUAL_INPUTS_ENV))
    if why:
        return None, why
    return input_values(job, given)


def _validate_job(root, name, job):
    """Return (errors, normalized job)."""
    errors = []
    prefix = f"job {name}"
    if not JOB_NAME_RE.match(name):
        errors.append(f"{prefix}: invalid job name (letters, digits, - and _ "
                      "only)")
    if not isinstance(job, dict):
        return errors + [f"{prefix}: a job must be an object"], None

    for key in job:
        if key not in JOB_FIELDS:
            errors.append(f"{prefix}: unknown field {key}")

    # name (the display name; data, never part of a command line)
    title = job.get("name", default_title(name))
    if "name" in job:
        if not isinstance(title, str):
            errors.append(f"{prefix}: name must be a string (a short "
                          "human-readable display name)")
            title = default_title(name)
        elif not title.strip():
            errors.append(f"{prefix}: name is empty; give a short "
                          "human-readable display name or leave the field "
                          "out")
            title = default_title(name)
        elif not all(ch.isprintable() for ch in title):
            errors.append(f"{prefix}: name {title!r} must be a single line "
                          "of printable characters (no newline, tab or "
                          "other control character)")
            title = default_title(name)

    # on
    on = job.get("on", [])
    if not _is_str_list(on):
        errors.append(f"{prefix}: on must be an array of triggers "
                      f"({', '.join(TRIGGERS)})")
        on = []
    else:
        for trigger in on:
            if trigger not in TRIGGERS:
                errors.append(f"{prefix}: unknown trigger {trigger!r} in on "
                              f"(allowed: {', '.join(TRIGGERS)})")
        dupes = sorted({m for m in on if on.count(m) > 1})
        for trigger in dupes:
            errors.append(f"{prefix}: trigger {trigger} listed more than once "
                          "in on")

    # branches
    branches = job.get("branches")
    if "branches" not in job:
        errors.append(f"{prefix}: missing required field branches")
        branches = []
    elif not _is_str_list(branches):
        errors.append(f"{prefix}: branches must be an array of strings")
        branches = []
    elif not branches:
        errors.append(f"{prefix}: missing required field branches (the list "
                      "is empty)")
    elif any(b == "" for b in branches):
        errors.append(f"{prefix}: branches contains an empty pattern")

    # cron
    has_cron = "cron" in on
    cron = job.get("cron")
    if "cron" in job:
        if not has_cron:
            errors.append(f"{prefix}: cron is set but on does not contain "
                          "cron")
        elif not isinstance(cron, str):
            errors.append(f"{prefix}: cron must be a string cron expression")
        elif len(cron.split()) != 5:
            errors.append(f"{prefix}: cron {cron!r} is not a cron expression "
                          "(five space-separated fields)")
    elif has_cron:
        errors.append(f"{prefix}: on contains cron but no cron expression is "
                      "given")
    if has_cron:
        for b in branches:
            if any(ch in b for ch in GLOB_CHARS):
                errors.append(f"{prefix}: a cron job's branches are literal "
                              f"names; {b!r} is a pattern")

    # paths
    paths = job.get("paths")
    if "paths" in job and not _is_str_list(paths):
        errors.append(f"{prefix}: paths must be an array of strings")
        paths = None

    # setup
    setup = job.get("setup")
    if "setup" in job:
        if not isinstance(setup, str):
            errors.append(f"{prefix}: setup must be one repository path "
                          "(a string)")
            setup = None
        elif any(ch.isspace() for ch in setup):
            errors.append(f"{prefix}: setup {setup!r} contains whitespace; "
                          "setup is one file, never a shell command line")
        else:
            errors.extend(_check_file(root, setup, f"{prefix}: setup"))

    # steps
    steps = job.get("steps")
    norm_steps = []
    if "steps" not in job:
        errors.append(f"{prefix}: missing required field steps")
    elif not isinstance(steps, list) or not steps:
        errors.append(f"{prefix}: steps must be a non-empty array")
    else:
        for i, step in enumerate(steps, 1):
            step_errors = _validate_step(root, step, f"{prefix}: step {i}")
            errors.extend(step_errors)
            if not step_errors:
                norm_steps.append([step] if isinstance(step, str)
                                  else list(step))

    # inputs
    inputs = {}
    if "inputs" in job:
        input_errors, inputs = _validate_inputs(prefix, job["inputs"])
        errors.extend(input_errors)

    # flags
    for flag in ("manual", "blocking"):
        if flag in job and not isinstance(job[flag], bool):
            errors.append(f"{prefix}: {flag} must be a boolean")

    normalized = {
        "name": name,
        "title": title,
        "on": list(on),
        "branches": list(branches),
        "paths": list(paths) if paths is not None else None,
        "setup": setup,
        "steps": norm_steps,
        "cron": cron if has_cron else None,
        "manual": job.get("manual", True) is not False,
        "blocking": job.get("blocking", True) is not False,
        "inputs": inputs,
    }
    return errors, normalized


def validate_config(data, root):
    """Validate a parsed config. Return the normalized config or raise
    ConfigError with every error found."""
    errors = []
    if not isinstance(data, dict):
        raise ConfigError(["config: the top level must be a JSON object"])

    for key in data:
        if key not in TOP_LEVEL_FIELDS:
            errors.append(f"config: unknown field {key}")

    jobs = {}
    raw_jobs = data.get("jobs")
    if "jobs" not in data:
        errors.append("config: missing required field jobs")
    elif not isinstance(raw_jobs, dict):
        errors.append("config: jobs must be an object (job name -> job)")
    else:
        for name, job in raw_jobs.items():
            job_errors, normalized = _validate_job(root, name, job)
            errors.extend(job_errors)
            if normalized is not None:
                jobs[name] = normalized

    needs_nothing = data.get("needs_nothing", [])
    if not _is_str_list(needs_nothing):
        errors.append("config: needs_nothing must be an array of path "
                      "patterns")
        needs_nothing = []

    max_parallel = data.get("max_parallel", DEFAULT_MAX_PARALLEL)
    if (not isinstance(max_parallel, int) or isinstance(max_parallel, bool)
            or max_parallel < 1):
        errors.append("config: max_parallel must be a positive integer")
        max_parallel = DEFAULT_MAX_PARALLEL

    if errors:
        raise ConfigError(errors)
    return {
        "jobs": jobs,
        "needs_nothing": list(needs_nothing),
        "max_parallel": max_parallel,
    }


def load_config(root, path=None):
    """Read and validate the config. Raise ConfigError on any problem."""
    path = path or os.path.join(root, CONFIG_PATH)
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except OSError as e:
        raise ConfigError([f"config: cannot read {path}: {e.strerror}"])
    try:
        data = json.loads(text)
    except json.JSONDecodeError as e:
        raise ConfigError([f"config: {path} is not valid JSON: {e}"])
    config = validate_config(data, root)
    config["path"] = path
    return config


# ── Decide ──────────────────────────────────────────────────────────────────

ALL_TRIGGERS = TRIGGERS + ("manual",)


def check_trigger(config, trigger):
    """Raise UsageError for a trigger the interface does not know. Every
    trigger it knows executes."""
    if trigger not in ALL_TRIGGERS:
        raise UsageError(f"unknown trigger {trigger!r} (allowed: "
                         f"{', '.join(ALL_TRIGGERS)})")


def resolve_commit(root, rev):
    """Resolve a revision to a commit sha, or None. The revision is passed
    as one argv element after --end-of-options, never through a shell."""
    if not rev:
        return None
    result = git("rev-parse", "--verify", "--quiet", "--end-of-options",
                 rev + "^{commit}", cwd=root)
    if result.returncode != 0:
        return None
    return result.stdout.strip()


def changed_files(root, base, head):
    """What the branch changed since it left the base: base...head.

    Return (files, None) or (None, why) when the diff cannot be computed.
    """
    if base and re.fullmatch(r"0+", base):  # a push that created the branch
        return None, (f"base {base!r} is the all-zero commit (the push "
                      "created the branch)")
    base_sha = resolve_commit(root, base)
    if base_sha is None:
        return None, f"base {base!r} is not a commit in this repository"
    head_sha = resolve_commit(root, head)
    if head_sha is None:
        return None, f"head {head!r} is not a commit in this repository"
    result = subprocess.run(
        ["git", "diff", "--name-only", "--no-renames", "-z",
         f"{base_sha}...{head_sha}"],
        cwd=root, capture_output=True)
    if result.returncode != 0:
        err = result.stderr.decode("utf-8", "replace").strip()
        return None, "git diff failed: " + (err.splitlines()[0] if err
                                              else f"exit {result.returncode}")
    out = result.stdout.decode("utf-8", "surrogateescape")
    return [f for f in out.split("\0") if f], None


def _norm(path):
    return os.path.normpath(path).replace(os.sep, "/")


def job_scripts(config):
    """Every file any job names (setup and step files), whatever its
    triggers."""
    files = set()
    for job in config["jobs"].values():
        if job["setup"]:
            files.add(_norm(job["setup"]))
        for step in job["steps"]:
            files.add(_norm(step[0]))
    return files


def config_relpath(config, root):
    path = config.get("path") or os.path.join(root, CONFIG_PATH)
    rel = os.path.relpath(os.path.abspath(path), os.path.abspath(root))
    return _norm(rel)


def _name_files(files, limit=5):
    shown = ", ".join(files[:limit])
    if len(files) > limit:
        shown += f" (and {len(files) - limit} more)"
    return shown


def manual_refusal(config, name, target):
    """Why a manual run of job `name` on branch `target` is refused, or None
    when it may run: the job must exist, allow manual runs and have branches
    that match the branch the run was started on."""
    job = config["jobs"].get(name)
    if job is None:
        return (f"unknown job {name!r} (declared: "
                f"{', '.join(config['jobs']) or 'none'})")
    if not job["manual"]:
        return f'job {name} cannot be run by hand ("manual": false)'
    if not match_any(job["branches"], target or ""):
        return (f"branch {target} does not match the branches of job {name} "
                f"({', '.join(job['branches'])})")
    return None


def decide_manual(config, target, source, base, head, job):
    """A manual run: the named job is needed when it may run (paths and
    needs_nothing are ignored); every other job is not needed. A refusal is
    recorded in the decision record, never raised, so the report shows it."""
    refused = manual_refusal(config, job, target)
    if not refused:
        _, refused = manual_input_values(config["jobs"][job])
    decisions = []
    for name, j in config["jobs"].items():
        if name != job:
            needed, reason = False, "not the job asked for"
        elif refused:
            needed, reason = False, refused
        else:
            needed, reason = True, "manual run"
        decisions.append({"name": name, "title": j["title"],
                          "needed": needed, "reason": reason,
                          "blocking": j["blocking"]})
    return {
        "trigger": "manual",
        "target": target,
        "source": source,
        "base": base,
        "head": head,
        "job": job,
        "refused": refused,
        "changed_files": [],
        "jobs": decisions,
        "max_parallel": config["max_parallel"],
    }


def _cron_key(expr):
    return " ".join(str(expr or "").split())


def branch_head(root, branch):
    """A cron branch's head commit: origin/<branch> after a full checkout,
    resolved once so every job on the branch runs on the same commit."""
    return resolve_commit(root, f"refs/remotes/origin/{branch}")


def decide_cron(config, root, cron):
    """A schedule fired: the runs are every (job, branch) pair whose job has
    cron in on and whose expression is the one that fired, for each of its
    literal branches. paths do not apply. A branch that does not exist is
    recorded as missing, and the report fails it."""
    fired = _cron_key(cron)
    heads = {}
    runs = []
    missing = []
    decisions = []
    for name, job in config["jobs"].items():
        if "cron" not in job["on"]:
            needed, reason = False, "not a cron job"
        elif _cron_key(job["cron"]) != fired:
            needed, reason = False, f"scheduled at {job['cron']}"
        else:
            needed, reason = True, f"scheduled {job['cron']}"
            for n, branch in enumerate(job["branches"], 1):
                if branch not in heads:
                    heads[branch] = branch_head(root, branch)
                if heads[branch] is None:
                    missing.append({"job": name, "branch": branch,
                                    "reason": f"branch {branch} does not "
                                              "exist"})
                else:
                    runs.append({"key": f"{name}-{n}", "job": name,
                                 "branch": branch, "sha": heads[branch]})
        decisions.append({"name": name, "title": job["title"],
                          "needed": needed, "reason": reason,
                          "blocking": job["blocking"]})
    return {
        "trigger": "cron",
        "cron": cron,
        "target": None,
        "source": None,
        "base": None,
        "head": None,
        "changed_files": [],
        "heads": heads,
        "runs": runs,
        "missing": missing,
        "jobs": decisions,
        "max_parallel": config["max_parallel"],
    }


def _article(word):
    return "an" if word[:1] in "aeiou" else "a"


def decide(config, root, trigger, target, source, base, head, files=None,
           diff_error=None, job=None, cron=None):
    """Decide every declared job for the trigger, one decision each, with a
    reason. Return the decision record (what `decide --json` prints)."""
    check_trigger(config, trigger)
    if trigger == "manual":
        return decide_manual(config, target, source, base, head, job)
    if trigger == "cron":
        return decide_cron(config, root, cron)
    if files is None and diff_error is None:
        files, diff_error = changed_files(root, base, head)

    needs_nothing = config["needs_nothing"]
    force = None
    if files is not None:
        if not files:
            force = "no changed files found"
        else:
            forcing = job_scripts(config) | {config_relpath(config, root),
                                             CONFIG_PATH}
            touched = [f for f in files if _norm(f) in forcing]
            if touched:
                force = "config or job script changed: " + _name_files(touched)
            else:
                covering = [j["paths"] for j in config["jobs"].values()
                            if j["paths"] is not None]
                uncovered = [f for f in files
                             if not match_any(needs_nothing, f)
                             and not any(match_any(p, f) for p in covering)]
                if uncovered:
                    verb = "is" if len(uncovered) == 1 else "are"
                    force = (f"{_name_files(uncovered)} {verb} in no job's "
                             "paths and not in needs_nothing")
    else:
        force = f"cannot compute the diff: {diff_error}"

    relevant = [f for f in (files or []) if not match_any(needs_nothing, f)]
    decisions = []
    for name, job in config["jobs"].items():
        if trigger not in job["on"]:
            needed, reason = False, f"not {_article(trigger)} {trigger} job"
        elif not match_any(job["branches"], target or ""):
            needed, reason = False, f"target {target} does not match branches"
        elif force:
            needed, reason = True, force
        elif not relevant:
            needed, reason = False, "only needs_nothing files changed"
        elif job["paths"] is None:
            n = len(relevant)
            needed = True
            reason = (f"{n} changed file{'' if n == 1 else 's'} outside "
                      "needs_nothing (the job has no paths)")
        else:
            hits = [f for f in relevant if match_any(job["paths"], f)]
            if hits:
                n = len(hits)
                needed = True
                reason = f"{n} changed file{'' if n == 1 else 's'} match paths"
            else:
                needed, reason = False, "no changed file matches paths"
        decisions.append({"name": name, "title": job["title"],
                          "needed": needed, "reason": reason,
                          "blocking": job["blocking"]})

    return {
        "trigger": trigger,
        "target": target,
        "source": source,
        "base": base,
        "head": head,
        "changed_files": list(files or []),
        "jobs": decisions,
        "max_parallel": config["max_parallel"],
    }


def needed_jobs(decision):
    return [j["name"] for j in decision["jobs"] if j["needed"]]


def format_decision(decision):
    if decision["trigger"] == "cron":
        lines = [f"git-cicd decide: trigger cron, schedule {decision['cron']}"]
        for branch, sha in decision["heads"].items():
            lines.append(f"  branch {branch}: "
                         + (sha if sha else "does not exist"))
        for run in decision["runs"]:
            lines.append(f"  run {run['job']} on {run['branch']} at "
                         f"{run['sha']}")
    else:
        lines = [f"git-cicd decide: trigger {decision['trigger']}, target "
                 f"{decision['target']}, source {decision['source']}",
                 f"  base {decision['base']}, head {decision['head']}",
                 f"  {len(decision['changed_files'])} changed files"]
    if decision.get("refused"):
        lines.append(f"  refused: {decision['refused']}")
    for j in decision["jobs"]:
        state = "needed" if j["needed"] else "not needed"
        lines.append(f"  {j['name']}: {state} ({j['reason']})")
    return "\n".join(lines)


def write_github_output(decision):
    """Append the outputs the generated workflow reads, when in Actions."""
    path = os.environ.get("GITHUB_OUTPUT")
    if not path:
        return
    with open(path, "a", encoding="utf-8") as f:
        f.write(f"jobs={json.dumps(needed_jobs(decision))}\n")
        names = {j["name"]: j.get("title") or default_title(j["name"])
                 for j in decision["jobs"]}
        f.write(f"names={json.dumps(names)}\n")
        any_run = decision["runs"] if decision["trigger"] == "cron" \
            else needed_jobs(decision)
        f.write(f"any={'true' if any_run else 'false'}\n")
        f.write(f"max_parallel={decision['max_parallel']}\n")
        if decision["trigger"] == "cron":
            # the cron matrix: one entry per (job, branch), cron only, so
            # the outputs of the other triggers stay as they are
            f.write(f"runs={json.dumps(decision['runs'])}\n")


def write_changed_files(path, files):
    with open(path, "w", encoding="utf-8", errors="surrogateescape") as f:
        for name in files:
            f.write(name + "\n")


# ── Run ─────────────────────────────────────────────────────────────────────

def script_env(job_name, facts, changed_files_path, inputs=None):
    """The inherited environment plus the CICD_ facts about the change and
    one CICD_INPUT_<NAME> per declared input.

    Inherited CICD_INPUT_ variables and the manual run's raw values
    (CICD_MANUAL_INPUTS) are removed, so the declared inputs are the only
    channel. GITHUB_TOKEN and VENDOR_PAT reach scripts unchanged through the
    inherited environment; git-cicd itself never reads or logs them.
    """
    env = {k: v for k, v in os.environ.items()
           if not k.startswith(INPUT_ENV_PREFIX) and k != MANUAL_INPUTS_ENV}
    for key, value in (inputs or {}).items():
        env[input_env_name(key)] = value
    env.update({
        "CICD_TRIGGER": facts["trigger"],
        "CICD_JOB": job_name,
        "CICD_TARGET_BRANCH": facts["target"],
        "CICD_SOURCE_BRANCH": facts["source"],
        "CICD_BASE": facts["base"],
        "CICD_HEAD": facts["head"],
        "CICD_CHANGED_FILES": changed_files_path,
    })
    return env


def _run_script(argv, root, env, header):
    """Run one script directly (list argv, no shell), streaming its output.
    Return (exit_code or None, error or None, seconds)."""
    print(f"==> git-cicd: {header}", flush=True)
    sys.stderr.flush()
    start = time.monotonic()
    try:
        code = subprocess.run(argv, cwd=root, env=env).returncode
        error = None
    except OSError as e:
        code, error = None, f"cannot execute {argv[0]}: {e.strerror or e}"
        print(f"==> git-cicd: {error}", flush=True)
    seconds = round(time.monotonic() - start, 3)
    return code, error, seconds


def run_job(config, root, name, facts, setup=False, files=None):
    """Run a job: setup when asked, then each step in order, stopping at the
    first failing step. Return the result record."""
    check_trigger(config, facts["trigger"])
    job = config["jobs"].get(name)
    if job is None:
        raise UsageError(f"unknown job {name!r} (declared: "
                         f"{', '.join(config['jobs']) or 'none'})")
    if facts["trigger"] == "manual":
        refused = manual_refusal(config, name, facts["target"])
        if not refused:
            inputs, refused = manual_input_values(job)
        if refused:
            raise UsageError(f"manual run refused: {refused}")
        files = []  # a manual run has no change
    elif facts["trigger"] == "cron":
        inputs, _ = input_values(job)
        files = []  # a schedule has no change
    else:
        inputs, _ = input_values(job)  # the declared defaults
    if files is None:
        files, _ = changed_files(root, facts["base"], facts["head"])
    fd, changed_path = tempfile.mkstemp(prefix="git-cicd-changed-",
                                        suffix=".txt")
    os.close(fd)
    write_changed_files(changed_path, files or [])
    env = script_env(name, facts, os.path.abspath(changed_path), inputs)

    result = {"job": name, "target": facts["target"], "head": facts["head"],
              "state": "passed", "failed_step": None,
              "exit_code": 0, "error": None, "setup": None,
              "setup_skipped": bool(job["setup"]) and not setup,
              "steps": [], "seconds": 0.0}
    start = time.monotonic()
    try:
        if setup and job["setup"]:
            code, error, seconds = _run_script(
                [os.path.join(root, job["setup"])], root, env,
                f"job {name}: setup {job['setup']}")
            result["setup"] = {"script": job["setup"], "seconds": seconds,
                               "exit_code": code, "error": error}
            if code != 0:
                result.update(state="could not run", exit_code=code,
                              error=error)
                return result
        total = len(job["steps"])
        for i, step in enumerate(job["steps"], 1):
            label = shlex.join(step)
            argv = [os.path.join(root, step[0]), *step[1:]]
            code, error, seconds = _run_script(
                argv, root, env, f"job {name}: step {i}/{total} {label}")
            result["steps"].append({"step": label, "file": step[0],
                                    "seconds": seconds,
                                    "exit_code": code, "error": error})
            if code != 0:
                result.update(state="failed", failed_step=label,
                              exit_code=code, error=error)
                return result
        return result
    finally:
        result["seconds"] = round(time.monotonic() - start, 3)
        try:
            os.unlink(changed_path)
        except OSError:
            pass


# ── Workflow ────────────────────────────────────────────────────────────────

TOOL_PATH_RE = re.compile(r"^[A-Za-z0-9._/-]+$")


def tool_path(root):
    """The running script's path relative to the repository root: where the
    tool is installed, never something the config decides."""
    here = os.path.realpath(os.path.abspath(__file__))
    rel = _norm(os.path.relpath(here, os.path.realpath(root)))
    if rel.startswith("../") or rel == "..":
        raise UsageError(f"git-cicd runs from {here}, outside the repository "
                         f"{root}; the generated workflow needs the tool "
                         "inside the repository (install it, or run the "
                         "installed copy)")
    if not TOOL_PATH_RE.match(rel):
        raise UsageError(f"the tool path {rel!r} contains characters the "
                         "generated workflow does not accept")
    return rel


def template_text(trigger):
    path = os.path.join(os.path.dirname(os.path.realpath(
        os.path.abspath(__file__))), TEMPLATE_DIR, f"{trigger}.yml")
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except OSError as e:
        raise UsageError(f"cannot read the workflow template {path}: "
                         f"{e.strerror}")


def schedule_block(config):
    crons = sorted({j["cron"] for j in config["jobs"].values()
                    if "cron" in j["on"] and j["cron"]})
    if not crons:
        return ""
    lines = ["  schedule:"]
    lines += [f"    - cron: {json.dumps(c)}" for c in crons]
    return "\n".join(lines) + "\n"


def render_workflow(config, tool, template):
    """One workflow file from its template, deterministic byte for byte. A
    template is fixed text; the only part that depends on the config is the
    schedule block, which only the cron template holds (`__SCHEDULE__`). The
    tool path depends on where the tool is installed."""
    text = template.replace("__SCHEDULE__\n", schedule_block(config))
    return text.replace("__TOOL__", tool)


def has_cron_jobs(config):
    return bool(schedule_block(config))


def rendered_triggers(config):
    """The triggers whose workflow the config generates: every one, except
    cron when no job has cron in on (GitHub needs an event under on:, and a
    schedule must never fire with nothing to run)."""
    return [t for t in GENERATED_TRIGGERS
            if t != "cron" or has_cron_jobs(config)]


def stale_paths(config):
    """Generated files the config no longer generates: the cron workflow when
    no job has cron in on."""
    return [WORKFLOWS[t][1] for t in GENERATED_TRIGGERS
            if t not in rendered_triggers(config)]


def render_workflows(config, tool, templates=None):
    """{path: text} for every workflow the config generates, in trigger
    order."""
    out = {}
    for trigger in rendered_triggers(config):
        template = (templates or {}).get(trigger)
        if template is None:
            template = template_text(trigger)
        out[WORKFLOWS[trigger][1]] = render_workflow(config, tool, template)
    return out


def generated_paths():
    return [WORKFLOWS[m][1] for m in GENERATED_TRIGGERS]


def generate_command(tool):
    return f"{tool} generate"


def verify_workflow(config, root, tool=None):
    """Regenerate every workflow in memory and compare each whole file; the
    single file of earlier versions must be gone.

    Return (ok, message); message holds a unified diff per file that differs
    and the command to run when anything does not match."""
    tool = tool or tool_path(root)
    problems = []
    for rel, expected in render_workflows(config, tool).items():
        try:
            with open(os.path.join(root, rel), encoding="utf-8",
                      newline="") as f:
                actual = f.read()
        except OSError:
            actual = None
        if actual == expected:
            continue
        if actual is None:
            problems.append(f"{rel} is missing\n")
        else:
            problems.append("".join(difflib.unified_diff(
                actual.splitlines(keepends=True),
                expected.splitlines(keepends=True),
                fromfile=f"{rel} (committed)",
                tofile=f"{rel} (generated from the config)")))
    commit = ", ".join(render_workflows(config, tool))
    removals = []
    for rel in stale_paths(config):
        if os.path.lexists(os.path.join(root, rel)):
            problems.append(f"{rel} is still there, but no job has cron in "
                            "on (generate removes it)\n")
            removals.append(rel)
    if os.path.lexists(os.path.join(root, LEGACY_WORKFLOW_PATH)):
        problems.append(f"{LEGACY_WORKFLOW_PATH} is still there (the single "
                        "workflow of earlier git-cicd versions; generate "
                        "removes it)\n")
        removals.append(LEGACY_WORKFLOW_PATH)
    if removals:
        commit += f" and the removal of {', '.join(removals)}"
    if not problems:
        return True, "workflows match config"
    return False, ("".join(problems) + "the workflows do not match the "
                   f"config; run: {generate_command(tool)} and commit "
                   f"{commit}")


# ── Report ──────────────────────────────────────────────────────────────────

def load_results(directory):
    """Every run-job result JSON under directory (any nesting), by job."""
    return {r["job"]: r for r in load_result_list(directory)}


def load_result_list(directory):
    """Every run-job result JSON under directory (any nesting), in order (a
    cron run has one per job and branch)."""
    results = []
    if not directory or not os.path.isdir(directory):
        return results
    for dirpath, dirnames, filenames in os.walk(directory):
        dirnames.sort()
        for filename in sorted(filenames):
            if not filename.endswith(".json"):
                continue
            try:
                with open(os.path.join(dirpath, filename),
                          encoding="utf-8") as f:
                    data = json.load(f)
            except (OSError, ValueError):
                continue
            if isinstance(data, dict) and isinstance(data.get("job"), str) \
                    and "state" in data:
                results.append(data)
    return results


def _secs(value):
    return f"{value:.1f}s" if isinstance(value, (int, float)) else "-"


def _exit_text(code, error):
    return f"error: {error}" if error else f"exit {code}"


SEMVER_CONFIG_PATH = ".vendored/configs/git-semver.json"
VENDOR_PKG_PREFIX = ".vendored/pkg/"
VENDOR_VERSION_PATH = ".vendored/manifests/{vendor}.version"


def repo_name(root):
    """The name of the repository the checks run in.

    In Actions, the name part of GITHUB_REPOSITORY (the platform's own fact).
    Locally, the last path segment of the `origin` remote's URL without
    `.git`; with no such remote, the name of the checkout's top-level
    directory."""
    gh = os.environ.get("GITHUB_REPOSITORY", "").strip()
    if gh:
        return gh.rstrip("/").rsplit("/", 1)[-1]
    url = _git_out(root, "config", "--get", "remote.origin.url")
    if url:
        name = re.split(r"[/:]", url.rstrip("/"))[-1]
        if name.endswith(".git"):
            name = name[:-len(".git")]
        if name:
            return name
    return os.path.basename(os.path.abspath(root)) or "repository"


def _read_version(root, rel):
    """The first line of a version file, or None when there is none. A
    version is read, never guessed."""
    if not isinstance(rel, str) or not rel or os.path.isabs(rel) \
            or ".." in rel.replace("\\", "/").split("/"):
        return None
    try:
        with open(os.path.join(root, rel), encoding="utf-8") as f:
            line = f.readline().strip()
    except (OSError, ValueError):
        return None
    if not line or not all(ch.isprintable() for ch in line):
        return None
    return line


def repo_version_file(root):
    """The version file the repository's git-semver config names (default
    VERSION)."""
    try:
        with open(os.path.join(root, SEMVER_CONFIG_PATH),
                  encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError):
        data = None
    if isinstance(data, dict) and isinstance(data.get("version_file"), str):
        return data["version_file"]
    return "VERSION"


def step_owner(root, path, repo):
    """(owner, version or None) of a setup or step file: the vendor for a
    file under .vendored/pkg/<vendor>/ with the version from its manifest,
    otherwise the repository with the version from its version file."""
    rel = _norm(path or "")
    if rel.startswith(VENDOR_PKG_PREFIX):
        vendor = rel[len(VENDOR_PKG_PREFIX):].split("/", 1)[0]
        if vendor:
            return vendor, _read_version(
                root, VENDOR_VERSION_PATH.format(vendor=vendor))
    if root is None:
        return repo, None
    return repo, _read_version(root, repo_version_file(root))


def row_name(title, repo, job):
    """A job's row: `<name> / <repo>:<job>`. No version: a row name is what
    anything waiting on a check refers to."""
    return f"{title} / {repo}:{job}"


def step_name(title, owner, version, job, path):
    """A step's report line: `<name> / <owner>@<version>:<job>:<step>`, the
    step being its file name; without `@<version>` when there is none."""
    at = f"@{version}" if version else ""
    return f"{title} / {owner}{at}:{job}:{os.path.basename(_norm(path))}"


def _child_result(code, error):
    if error:
        return f"failed (error: {error})"
    if code == 0:
        return "passed"
    return f"failed (exit {code})"


def short_head(root, head):
    """The head commit, short, for the report's header."""
    if not head:
        return "unknown"
    if root is not None:
        sha = resolve_commit(root, str(head))
        if sha:
            return _git_out(root, "rev-parse", "--short", sha) or sha[:7]
    head = str(head)
    if re.fullmatch(r"[0-9a-f]{7,40}", head):
        return head[:7]
    return head


def job_rows(config, decision, results, root=None, repo=None):
    """One row per declared job, in config order."""
    repo = repo or (repo_name(root) if root is not None else "repository")
    by_name = {j["name"]: j for j in (decision or {}).get("jobs", [])}
    rows = []
    for name, job in config["jobs"].items():
        title = job.get("title") or default_title(name)
        d = by_name.get(name)
        row = {"name": name, "title": title,
               "display": row_name(title, repo, name),
               "blocking": job["blocking"], "seconds": None,
               "children": [], "setup_skipped": False}
        if d is None:
            row.update(state="could not run", detail="no decision")
        elif not d["needed"]:
            row.update(state="not needed", detail=d["reason"])
        else:
            r = results.get(name)
            if r is None:
                row.update(state="could not run", detail="no result")
            else:
                row["seconds"] = r.get("seconds")
                row["setup_skipped"] = bool(r.get("setup_skipped"))
                setup = r.get("setup")
                if setup:
                    path = setup.get("script") or job["setup"] or "setup"
                    owner, version = step_owner(root, path, repo)
                    row["children"].append(
                        (step_name(title, owner, version, name, path),
                         setup.get("seconds"),
                         _child_result(setup.get("exit_code"),
                                       setup.get("error"))))
                for step in r.get("steps", []):
                    path = step.get("file")
                    if not path:
                        try:
                            path = shlex.split(str(step.get("step")))[0]
                        except (ValueError, IndexError):
                            path = str(step.get("step"))
                    owner, version = step_owner(root, path, repo)
                    row["children"].append(
                        (step_name(title, owner, version, name, path),
                         step.get("seconds"),
                         _child_result(step.get("exit_code"),
                                       step.get("error"))))
                state = r.get("state")
                if state == "passed":
                    row.update(state="passed", detail="")
                elif state == "could not run":
                    row.update(state="could not run", detail="setup failed")
                else:
                    row.update(state="failed", detail=(
                        f"step {r.get('failed_step')}, "
                        + _exit_text(r.get("exit_code"), r.get("error"))))
        rows.append(row)
    return rows


def verdict_line(rows, decision, workflow_ok):
    total = len(rows)
    needed = [r for r in rows if r["state"] != "not needed"]
    counts = {}
    nonblocking_bad = 0
    blocking_bad = False
    for r in needed:
        counts[r["state"]] = counts.get(r["state"], 0) + 1
        if r["state"] in ("failed", "could not run"):
            if r["blocking"]:
                blocking_bad = True
            else:
                nonblocking_bad += 1
    passed = not blocking_bad and workflow_ok and decision is not None
    word = "PASSED" if passed else "FAILED"
    if decision is None:
        return passed, (f"{word} - no decisions: the decide step failed or "
                        "did not run (see its log)")
    if decision.get("refused"):
        text = f"FAILED - {decision['refused']}"
        if not workflow_ok:
            text += "; the workflows do not match the config"
        return False, text
    if not needed:
        reasons = []
        for r in rows:
            if r["detail"] not in reasons:
                reasons.append(r["detail"])
        why = "; ".join(reasons) if reasons else "no jobs are declared"
        text = f"{word} - 0 of {total} jobs needed: {why}"
    else:
        parts = [f"{len(needed)} of {total} jobs needed"]
        for state in ("passed", "failed", "could not run"):
            if counts.get(state):
                parts.append(f"{counts[state]} {state}")
        text = f"{word} - " + ", ".join(parts)
        if nonblocking_bad:
            text += f" ({nonblocking_bad} non-blocking)"
    if not workflow_ok:
        text += "; the workflows do not match the config"
    return passed, text


def _state_text(row):
    text = row["state"]
    if row["detail"]:
        text += f" ({row['detail']})"
    if not row["blocking"]:
        text += " (non-blocking)"
    return text


def header_text(repo, head, branch=None):
    where = f" on {branch}" if branch else ""
    return (f"git-cicd report: {repo}{where} at {head} (the change under "
            "test; a version below is its owner's last release)")


def format_report(rows, verdict, workflow_text, setup_note=False,
                  header="git-cicd report"):
    width = max([len(r["display"]) for r in rows] + [4])
    lines = [header]
    for r in rows:
        time_text = _secs(r["seconds"]) if r["seconds"] is not None else ""
        lines.append(f"  {r['display']:<{width}}  {_state_text(r)}"
                     + (f"  {time_text}" if time_text else ""))
        for label, seconds, result in r["children"]:
            lines.append(f"    {label}  {result}  {_secs(seconds)}")
        if setup_note and r["setup_skipped"]:
            lines.append("    setup skipped (pass --setup to run it)")
    lines.append(workflow_text)
    lines.append(verdict)
    return "\n".join(lines) + "\n"


def _md(text):
    return str(text).replace("|", "\\|").replace("\n", " ")


def _md_code(text):
    """Text as inline code, shown literally whatever it holds."""
    text = _md(text)
    fence = "`"
    while fence in text:
        fence += "`"
    pad = " " if text.startswith("`") or text.endswith("`") else ""
    return f"{fence}{pad}{text}{pad}{fence}"


def format_markdown(rows, verdict, workflow_text, setup_note=False,
                    header="git-cicd report"):
    word = verdict.split(" ", 1)[0]
    lines = [f"## {VERDICT_STATUS}: {word}", "", f"**{_md(verdict)}**", "",
             _md(header), "",
             "| Job | State | Time | Detail |", "|---|---|---|---|"]
    for r in rows:
        state = r["state"] + ("" if r["blocking"] else " (non-blocking)")
        time_text = _secs(r["seconds"]) if r["seconds"] is not None else ""
        lines.append(f"| {_md_code(r['display'])} | {_md(state)} | "
                     f"{time_text} | {_md(r['detail'])} |")
        for label, seconds, result in r["children"]:
            lines.append(f"| &nbsp;&nbsp;↳ {_md_code(label)} | {_md(result)} "
                         f"| {_secs(seconds)} | |")
        if setup_note and r["setup_skipped"]:
            lines.append("| &nbsp;&nbsp;↳ setup | skipped | | pass --setup "
                         "to run it |")
    lines += ["", f"Workflow: {_md(workflow_text)}", ""]
    return "\n".join(lines)


def _workflow_text(root, workflow_ok):
    if workflow_ok:
        return "workflows match config"
    try:
        tool = tool_path(root)
    except UsageError:
        tool = "git-cicd"
    return f"workflows do not match config: run {generate_command(tool)}"


def _write_summary(text):
    summary = os.environ.get("GITHUB_STEP_SUMMARY")
    if summary:
        with open(summary, "a", encoding="utf-8") as f:
            f.write(text)


def branch_decision(decision, branch):
    """The part of a cron decision for one branch, shaped like the decision
    of the other triggers: a job is needed on the branch when it has a run
    (or a missing run) there."""
    on_branch = {r["job"] for r in decision.get("runs", [])
                 if r["branch"] == branch}
    on_branch |= {m["job"] for m in decision.get("missing", [])
                  if m["branch"] == branch}
    jobs = []
    for d in decision["jobs"]:
        d = dict(d)
        if d["needed"] and d["name"] not in on_branch:
            d.update(needed=False, reason=f"not scheduled on {branch}")
        jobs.append(d)
    sha = (decision.get("heads") or {}).get(branch)
    return dict(decision, jobs=jobs, target=branch, source=branch, base=sha,
                head=sha)


def report_cron(config, root, decision, result_list, workflow_ok, out):
    """A cron report: one section and one verdict per branch the run is for,
    then the run's verdict. Return (passed, verdict line, verdicts), the
    verdicts being (sha, passed, verdict line) per branch head."""
    workflow_text = _workflow_text(root, workflow_ok)
    repo = repo_name(root)
    heads = decision.get("heads") or {}
    verdicts = []
    failed = []
    for branch, sha in heads.items():
        part = branch_decision(decision, branch)
        results = {r["job"]: r for r in result_list
                   if r.get("target") == branch}
        rows = job_rows(config, part, results, root=root, repo=repo)
        if sha is None:
            why = f"branch {branch} does not exist"
            for row in rows:
                if row["state"] != "not needed":
                    row.update(state="could not run", detail=why)
            passed, verdict = False, f"FAILED - {why}"
        else:
            passed, verdict = verdict_line(rows, part, workflow_ok)
            verdicts.append((sha, passed, verdict))
        if not passed:
            failed.append(branch)
        header = header_text(repo, short_head(root, sha) if sha else
                             "no commit", branch)
        out.write(format_report(rows, verdict, workflow_text, header=header))
        _write_summary(format_markdown(rows, verdict, workflow_text,
                                       header=header))
    if not heads:
        rows = job_rows(config, decision, {}, root=root, repo=repo)
        passed, verdict = verdict_line(rows, decision, workflow_ok)
        header = f"git-cicd report: {repo}, schedule {decision.get('cron')}"
        out.write(format_report(rows, verdict, workflow_text, header=header))
        _write_summary(format_markdown(rows, verdict, workflow_text,
                                       header=header))
        out.flush()
        return passed, verdict, verdicts
    n = len(heads)
    word = "FAILED" if failed or not workflow_ok else "PASSED"
    verdict = (f"{word} - schedule {decision.get('cron')} on {n} "
               f"branch{'' if n == 1 else 'es'}")
    if failed:
        verdict += f", failed on {', '.join(failed)}"
    out.write(verdict + "\n")
    out.flush()
    return word == "PASSED", verdict, verdicts


def report(config, root, decision, results, workflow=None, setup_note=False,
           out=None):
    """Print the report, append it to GITHUB_STEP_SUMMARY when set, and
    return (passed, verdict line)."""
    out = out or sys.stdout
    if workflow is None:
        workflow = verify_workflow(config, root)
    workflow_ok = workflow[0]
    workflow_text = _workflow_text(root, workflow_ok)
    repo = repo_name(root)
    rows = job_rows(config, decision, results, root=root, repo=repo)
    passed, verdict = verdict_line(rows, decision, workflow_ok)
    header = header_text(repo, short_head(root, (decision or {}).get("head")))
    out.write(format_report(rows, verdict, workflow_text, setup_note,
                            header))
    out.flush()
    _write_summary(format_markdown(rows, verdict, workflow_text, setup_note,
                                   header))
    return passed, verdict


def load_decisions(path):
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError):
        return None
    if not isinstance(data, dict) or not isinstance(data.get("jobs"), list):
        return None
    return data


# ── Check (local) ───────────────────────────────────────────────────────────

def _git_out(root, *args):
    result = git(*args, cwd=root)
    return result.stdout.strip() if result.returncode == 0 else ""


def default_source(root):
    return _git_out(root, "rev-parse", "--abbrev-ref", "HEAD") or "HEAD"


def default_target(root, source):
    """The upstream's branch name if one is set (and it is not the branch's
    own remote copy), else the remote default branch, else main."""
    if source and source != "HEAD":
        upstream = _git_out(root, "rev-parse", "--abbrev-ref",
                            "--symbolic-full-name", "@{upstream}")
        remote = _git_out(root, "config", "--get",
                          f"branch.{source}.remote")
        if upstream:
            name = upstream
            if remote and remote != "." and name.startswith(remote + "/"):
                name = name[len(remote) + 1:]
            if name != source:
                return name
    origin_head = _git_out(root, "symbolic-ref", "--quiet", "--short",
                           "refs/remotes/origin/HEAD")
    if origin_head.startswith("origin/"):
        return origin_head[len("origin/"):]
    return "main"


def default_base(root, target):
    if resolve_commit(root, f"origin/{target}"):
        return f"origin/{target}"
    return target


def check(config, root, target=None, source=None, base=None, head=None,
          job=None, force=False, setup=False):
    """Decide, run the needed jobs one after another, report. Return the
    exit code (0 passed, 1 failed)."""
    if force and not job:
        raise UsageError("--force needs --job NAME")
    if job is not None and job not in config["jobs"]:
        raise UsageError(f"unknown job {job!r} (declared: "
                         f"{', '.join(config['jobs']) or 'none'})")
    source = source or default_source(root)
    target = target or default_target(root, source)
    base = base or default_base(root, target)
    head = head or "HEAD"
    base_sha = resolve_commit(root, base) or base
    head_sha = resolve_commit(root, head) or head

    files, diff_error = changed_files(root, base_sha, head_sha)
    decision = decide(config, root, "open", target, source, base_sha,
                      head_sha, files=files, diff_error=diff_error)
    if job is not None:
        for d in decision["jobs"]:
            if d["name"] != job:
                d.update(needed=False, reason=f"not selected (--job {job})")
            elif force and not d["needed"] and d["reason"] in (
                    "no changed file matches paths",
                    "only needs_nothing files changed"):
                d.update(needed=True, reason="forced with --force (paths "
                                             "ignored)")
    print(format_decision(decision), flush=True)

    facts = {"trigger": "open", "target": target, "source": source,
             "base": base_sha, "head": head_sha}
    results = {}
    for name in needed_jobs(decision):
        results[name] = run_job(config, root, name, facts, setup=setup,
                                files=files or [])
    print("", flush=True)
    passed, _ = report(config, root, decision, results,
                       setup_note=not setup)
    return 0 if passed else 1


# ── Commands ────────────────────────────────────────────────────────────────

def cmd_validate(args, root):
    config = load_config(root, args.config)
    n = len(config["jobs"])
    print(f"config ok: {n} jobs")
    return 0


def cmd_decide(args, root):
    config = load_config(root, args.config)
    if args.trigger == "manual" and args.job is None:
        raise UsageError("--trigger manual needs --job NAME (the job to run)")
    if args.trigger != "manual" and args.job is not None:
        raise UsageError(f"--job is for --trigger manual only, not "
                         f"--trigger {args.trigger}")
    if args.trigger == "cron":
        if not args.cron:
            raise UsageError("--trigger cron needs --cron EXPR (the schedule "
                             "that fired)")
    else:
        if args.cron is not None:
            raise UsageError(f"--cron is for --trigger cron only, not "
                             f"--trigger {args.trigger}")
        missing = [f"--{k}" for k in ("target", "source", "base", "head")
                   if getattr(args, k) is None]
        if missing:
            raise UsageError(f"--trigger {args.trigger} needs "
                             f"{', '.join(missing)}")
    decision = decide(config, root, args.trigger, args.target, args.source,
                      args.base, args.head, job=args.job, cron=args.cron)
    if args.changed_files_out:
        write_changed_files(args.changed_files_out, decision["changed_files"])
    write_github_output(decision)
    if args.json:
        print(json.dumps(decision, indent=2))
    else:
        print(format_decision(decision))
    return 0


def facts_from_args(args):
    return {"trigger": args.trigger, "target": args.target,
            "source": args.source, "base": args.base, "head": args.head}


def cmd_run_job(args, root):
    config = load_config(root, args.config)
    result = run_job(config, root, args.job, facts_from_args(args),
                     setup=args.setup)
    line = f"==> git-cicd: job {args.job}: {result['state']}"
    if result["state"] == "failed":
        line += f" (step {result['failed_step']}, exit {result['exit_code']})"
    print(f"{line} in {result['seconds']:.1f}s", flush=True)
    if args.result:
        with open(args.result, "w", encoding="utf-8") as f:
            json.dump(result, f, indent=2)
            f.write("\n")
    return 0 if result["state"] == "passed" else 1


def cmd_generate(args, root):
    config = load_config(root, args.config)
    for rel, text in render_workflows(config, tool_path(root)).items():
        path = os.path.join(root, rel)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8", newline="") as f:
            f.write(text)
        print(f"wrote {rel}")
    for rel in stale_paths(config):
        if os.path.lexists(os.path.join(root, rel)):
            os.remove(os.path.join(root, rel))
            print(f"removed {rel} (no job has cron in on; commit the "
                  "removal)")
    legacy = os.path.join(root, LEGACY_WORKFLOW_PATH)
    if os.path.lexists(legacy):
        os.remove(legacy)
        print(f"removed {LEGACY_WORKFLOW_PATH} (replaced by the per-trigger "
              "workflows; commit the removal)")
    return 0


def cmd_verify(args, root):
    config = load_config(root, args.config)
    ok, message = verify_workflow(config, root)
    print(message)
    return 0 if ok else 1


STATUS_DESCRIPTION_MAX = 140  # GitHub's limit on a commit status description


def status_description(verdict):
    """The verdict line as a commit status description: one line, at most
    STATUS_DESCRIPTION_MAX characters."""
    text = " ".join(str(verdict).split())
    if len(text) > STATUS_DESCRIPTION_MAX:
        text = text[:STATUS_DESCRIPTION_MAX - 3].rstrip() + "..."
    return text


def write_verdict(path, passed, verdict):
    """Write the commit status state (success or failure) and description,
    one per line, for the workflow step that sets the
    `Verdict / git-cicd:verdict` status."""
    if not path:
        return
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(("success" if passed else "failure") + "\n"
                + status_description(verdict) + "\n")


def write_cron_verdicts(path, verdicts):
    """Write one line per branch head for the cron workflow's status step:
    `<sha> TAB <state> TAB <description>`. Branches at the same commit share
    one status, failed when any of them failed."""
    if not path:
        return
    by_sha = {}
    for sha, passed, verdict in verdicts:
        if sha in by_sha and not by_sha[sha][0]:
            continue
        if sha not in by_sha or not passed:
            by_sha[sha] = (passed, verdict)
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        for sha, (passed, verdict) in by_sha.items():
            f.write(f"{sha}\t{'success' if passed else 'failure'}\t"
                    f"{status_description(verdict)}\n")


def cmd_report(args, root):
    try:
        config = load_config(root, args.config)
    except ConfigError as e:
        reason = "FAILED - the config is invalid: " + "; ".join(e.errors)
        if args.trigger == "cron":
            decision = load_decisions(args.decisions) or {}
            write_cron_verdicts(args.verdict_out, [
                (sha, False, reason) for sha in
                (decision.get("heads") or {}).values() if sha])
        else:
            write_verdict(args.verdict_out, False, reason)
        raise
    decision = load_decisions(args.decisions)
    if args.trigger == "cron" and decision is not None:
        passed, _, verdicts = report_cron(
            config, root, decision, load_result_list(args.results),
            verify_workflow(config, root)[0], sys.stdout)
        write_cron_verdicts(args.verdict_out, verdicts)
        return 0 if passed else 1
    passed, verdict = report(config, root, decision,
                             load_results(args.results))
    if args.trigger == "cron":
        write_cron_verdicts(args.verdict_out, [])
    else:
        write_verdict(args.verdict_out, passed, verdict)
    return 0 if passed else 1


def cmd_check(args, root):
    config = load_config(root, args.config)
    return check(config, root, target=args.target, source=args.source,
                 base=args.base, head=args.head, job=args.job,
                 force=args.force, setup=args.setup)


def add_change_args(p, required=True):
    """The facts about a change, as given by the platform or the caller.
    decide checks them per trigger (cron takes --cron instead)."""
    p.add_argument("--trigger", required=True, choices=ALL_TRIGGERS)
    p.add_argument("--target", required=required, help="target branch")
    p.add_argument("--source", required=required, help="source branch")
    p.add_argument("--base", required=required, help="base commit")
    p.add_argument("--head", required=required, help="head commit")


def build_parser():
    parser = argparse.ArgumentParser(
        prog="git-cicd",
        description="Decide which jobs a change needs, run them, report.")
    sub = parser.add_subparsers(dest="command", metavar="COMMAND")
    sub.required = True

    def add(name, func, help_text):
        p = sub.add_parser(name, help=help_text, description=help_text)
        p.add_argument("--config", default=None,
                       help=f"config file (default: {CONFIG_PATH} at the "
                            "repository root)")
        p.set_defaults(func=func)
        return p

    add("validate", cmd_validate, "load and validate the config")

    p = add("decide", cmd_decide, "decide which jobs a change needs")
    add_change_args(p, required=False)
    p.add_argument("--cron", metavar="EXPR",
                   help="with --trigger cron (and only then): the schedule "
                        "that fired (github.event.schedule)")
    p.add_argument("--job", metavar="NAME",
                   help="with --trigger manual (and only then): the job the "
                        "manual run is for")
    p.add_argument("--json", action="store_true",
                   help="print the decisions as JSON")
    p.add_argument("--changed-files-out", metavar="PATH",
                   help="write the changed files, one per line, to PATH")

    p = add("run-job", cmd_run_job,
            "run one job: setup when asked, then its steps, without a shell")
    p.add_argument("job", metavar="JOB")
    add_change_args(p)
    p.add_argument("--setup", action="store_true",
                   help="run the job's setup script first")
    p.add_argument("--result", metavar="PATH",
                   help="write the job's result JSON to PATH")

    add("generate", cmd_generate,
        f"write {', '.join(generated_paths())} from the config (and remove "
        f"{LEGACY_WORKFLOW_PATH})")
    add("verify", cmd_verify,
        f"check that {', '.join(generated_paths())} match what the config "
        f"generates and {LEGACY_WORKFLOW_PATH} is gone")

    p = add("report", cmd_report, "one line per job with times, and one "
            "verdict")
    p.add_argument("--decisions", required=True, metavar="FILE",
                   help="the JSON written by decide --json")
    p.add_argument("--results", required=True, metavar="DIR",
                   help="directory holding run-job --result files (any "
                        "nesting)")
    p.add_argument("--trigger", default="open", choices=ALL_TRIGGERS)
    p.add_argument("--verdict-out", metavar="PATH",
                   help="write the commit status state (success or failure) "
                        "and description, one per line, to PATH")

    p = add("check", cmd_check, "decide, run the needed jobs one after "
            "another and report, locally (no GitHub needed)")
    p.add_argument("--target", help="target branch (default: the upstream's "
                   "branch, else origin/HEAD, else main)")
    p.add_argument("--source", help="source branch (default: the current "
                   "branch)")
    p.add_argument("--base", help="base revision (default: origin/<target> "
                   "if it exists, else <target>)")
    p.add_argument("--head", help="head revision (default: HEAD)")
    p.add_argument("--job", metavar="NAME", help="run only this job (still "
                   "bound by its branches and the decision)")
    p.add_argument("--force", action="store_true",
                   help="with --job: run it regardless of its paths")
    p.add_argument("--setup", action="store_true",
                   help="run setup scripts (they install things for real)")
    return parser


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        root = repo_root()
        return args.func(args, root)
    except ConfigError as e:
        for line in e.errors:
            print(line, file=sys.stderr)
        return 2
    except UsageError as e:
        print(f"git-cicd: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
